#ifndef OSGEARTH_INSTANCE_BUILDER_H
#define OSGEARTH_INSTANCE_BUILDER_H 1

#include <osgEarth/Export>
#include <osg/ref_ptr>
#include <osg/Array>
#include <osg/BufferObject>
#include <osg/Geometry>
#include <osg/Uniform>

#include <cstddef>

namespace osgEarth
{
    class OSGEARTH_EXPORT InstanceBuilder
    {
    public:
        InstanceBuilder();
        static osg::Geometry* createGeometry();
        //! Make an instancing-capable shallow copy of existing geometry.
        static osg::Geometry* createGeometry(
            const osg::Geometry& geometry,
            const osg::CopyOp& copyop = osg::CopyOp::SHALLOW_COPY);
        osg::Vec3Array* getPositions() { return _positions.get(); };
        void setPositions(osg::Vec3Array* positions);
        osg::Vec4Array* getRotations() { return _rotations.get(); };
        void setRotations(osg::Vec4Array* rotations);
        osg::Vec3Array* getScales() { return _scales.get(); }
        void setScales(osg::Vec3Array* scales);
        //! RGB multipliers packed into the compact scale words at no extra cost.
        osg::Vec3Array* getTints() { return _tints.get(); }
        void setTints(osg::Vec3Array* tints);
        //! Reserve compact instance storage shared by all subsequently installed batches.
        void reserveInstances(std::size_t count);
        //! Quantize per-instance attributes after their floating-point bound is known.
        bool compressInstanceAttributes();
        //! Precompute one conservative instance bound for an entire model batch.
        void setBaseBoundingBox(const osg::BoundingBox& bounds) const;
        const osg::BoundingBox& getInstancedBoundingBox() const { return _instancedBoundingBox; }
        osg::Vec2f getRange() const { return _range; }
        void setRange(const osg::Vec2f& range);
        //! Introspection for compact, city-level instance storage.
        static const osg::BufferData* getInstanceBuffer(const osg::Geometry* geometry);
        static std::size_t getInstanceOffset(const osg::Geometry* geometry);
        static std::size_t getInstanceCount(const osg::Geometry* geometry);
        //! Compact batch data used by Kit's scene-wide collector.
        osg::BufferData* getInstanceBuffer() { return _instanceBuffer.get(); }
        const osg::BufferData* getInstanceBuffer() const { return _instanceBuffer.get(); }
        std::size_t getInstanceOffset() const { return _instanceOffset; }
        std::size_t getInstanceCount() const { return _instanceCount; }
        const osg::Vec3f& getPositionOffset() const { return _positionOffset; }
        const osg::Vec3f& getPositionScale() const { return _positionScale; }
        const osg::Vec3f& getScaleOffset() const { return _scaleOffset; }
        const osg::Vec3f& getScaleScale() const { return _scaleScale; }
        //! Install instance attributes and use the geometry's StateSet for the shader.
        void installInstancing(osg::Geometry* geometry) const;
        //! Install instance attributes while placing the shared shader on an ancestor.
        //! This preserves any model-specific VirtualProgram on the geometry itself.
        void installInstancing(
            osg::Geometry* geometry,
            osg::StateSet* shaderStateSet) const;
    protected:
        // A city-level interleaved instance VBO remains separate from immutable
        // model vertices and is shared by every compact batch in that city.
        osg::ref_ptr<osg::VertexBufferObject> _instanceVBO;
        osg::ref_ptr<osg::Vec3Array> _positions;
        osg::ref_ptr<osg::Vec4Array> _rotations;
        osg::ref_ptr<osg::Vec3Array> _scales;
        osg::ref_ptr<osg::Vec3Array> _tints;
        osg::ref_ptr<osg::BufferData> _instanceBuffer;
        std::size_t _instanceOffset = 0u;
        std::size_t _instanceCount = 0u;
        // Overall values 
        osg::ref_ptr<osg::Vec3Array> _position;
        osg::ref_ptr<osg::Vec4Array> _rotation;
        osg::ref_ptr<osg::Vec3Array> _scale;
        osg::Vec2f _range = osg::Vec2f(0.0f, 3.402823466e+38F);
        mutable osg::ref_ptr<osg::Uniform> _positionOffsetUniform;
        mutable osg::ref_ptr<osg::Uniform> _positionScaleUniform;
        mutable osg::ref_ptr<osg::Uniform> _scaleOffsetUniform;
        mutable osg::ref_ptr<osg::Uniform> _scaleScaleUniform;
        mutable osg::ref_ptr<osg::Uniform> _packedScaleTintUniform;
        mutable osg::ref_ptr<osg::Uniform> _rangeUniform;
        osg::Vec3f _positionOffset = osg::Vec3f(0.0f, 0.0f, 0.0f);
        osg::Vec3f _positionScale = osg::Vec3f(1.0f, 1.0f, 1.0f);
        osg::Vec3f _scaleOffset = osg::Vec3f(0.0f, 0.0f, 0.0f);
        osg::Vec3f _scaleScale = osg::Vec3f(1.0f, 1.0f, 1.0f);
        mutable osg::BoundingBox _instancedBoundingBox;

        void resetBatchUniforms();
        void createBatchUniforms() const;
    };
}
#endif // OSGEARTH_INSTANCE_BUILDER_H
