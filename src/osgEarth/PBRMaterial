#include <osgEarth/Config>
#include <osgEarth/URI>
#include <osgEarth/Status>
#include <osg/Texture>

namespace osgEarth
{
    class VirtualProgram;

    /**
    * Describes a PBR (physically-based rendering) material as a collection
    * of its component rasters.
    */
    class OSGEARTH_EXPORT PBRMaterial
    {
    public:
        // RM uses glTF's G/B channels without reading AO from R.
        enum Layout { DRAM = 0, ORM = 1, RM = 2 };

        PBRMaterial() = default;
        PBRMaterial(const PBRMaterial& rhs) = default;
        PBRMaterial& operator=(const PBRMaterial& rhs) = default;
        PBRMaterial(PBRMaterial&& rhs) = default;
        PBRMaterial& operator=(PBRMaterial&& rhs) = default;

        //! Images to use. If unset, PBRTexture will try to load from
        //! the corresponding URI. These are not serialized.
        osg::ref_ptr<osg::Image>
            colorImage,
            normalImage,
            roughnessImage,
            aoImage,
            metalImage,
            displacementImage,
            opacityImage,
            packedImage;

        OE_PROPERTY(std::string, name, {});
        OE_PROPERTY(Layout, layout, DRAM);
        OE_PROPERTY(float, roughnessFactor, 1.0f);
        OE_PROPERTY(float, metallicFactor, 1.0f);
        OE_PROPERTY(float, occlusionStrength, 1.0f);
        //! A packed input takes precedence over separate scalar rasters;
        //! aoImage/ao may supply an independent occlusion texture in this case.
        OE_OPTION(URI, packed);
        OE_OPTION(URI, color);
        OE_OPTION(URI, normal);
        OE_OPTION(URI, roughness);
        OE_OPTION(URI, ao);
        OE_OPTION(URI, metal);
        OE_OPTION(URI, displacement);
        OE_OPTION(URI, opacity);

        PBRMaterial(const Config& conf)
        {
            conf.get("name", name());
            if (name().empty())
                name() = conf.referrer();
            conf.get("color", color());
            conf.get("normal", normal());
            conf.get("roughness", roughness());
            conf.get("ao", ao());
            conf.get("metal", metal());
            conf.get("displacement", displacement());
            conf.get("height", displacement());
            conf.get("opacity", opacity());
            conf.get("packed", packed());
            const auto packing = conf.value("layout");
            if (packing == "orm") layout() = ORM;
            else if (packing == "rm") layout() = RM;
            conf.get("roughness_factor", roughnessFactor());
            conf.get("metallic_factor", metallicFactor());
            conf.get("occlusion_strength", occlusionStrength());
        }

        Config getConfig() const
        {
            Config conf("material");
            conf.set("name", name());
            conf.set("color", color());
            conf.set("normal", normal());
            conf.set("roughness", roughness());
            conf.set("ao", ao());
            conf.set("metal", metal());
            conf.set("displacement", displacement());
            conf.set("opacity", opacity());
            conf.set("packed", packed());
            if (layout() != DRAM) conf.set("layout", layout() == ORM ? "orm" : "rm");
            if (roughnessFactor() != 1.0f) conf.set("roughness_factor", roughnessFactor());
            if (metallicFactor() != 1.0f) conf.set("metallic_factor", metallicFactor());
            if (occlusionStrength() != 1.0f) conf.set("occlusion_strength", occlusionStrength());
            return conf;
        }

        //! Returns true if the material is "simple" (i.e., has only a color map)
        bool isSimple() const
        {
            return (colorImage.valid() || color().isSet()) &&
                !packedImage && !packed().isSet() && layout() == DRAM &&
                roughnessFactor() == 1.0f && metallicFactor() == 1.0f && occlusionStrength() == 1.0f &&
                !normalImage && !normal().isSet() &&
                !roughnessImage && !roughness().isSet() &&
                !aoImage && !ao().isSet() &&
                !metalImage && !metal().isSet() &&
                !displacementImage && !displacement().isSet() &&
                !opacityImage && !opacity().isSet();
        }
    };

    /**
    * Adapter that lets you place a PBR material collection in a state attribute.
    */
    class OSGEARTH_EXPORT PBRTexture : public osg::StateAttribute
    {
    public:
        META_StateAttribute(osgEarth, PBRTexture, TEXTURE);
        PBRTexture() = default;
        PBRTexture(const PBRTexture& rhs, const osg::CopyOp& op) :
            osg::StateAttribute(rhs, op), albedo(rhs.albedo), normal(rhs.normal), pbr(rhs.pbr),
            occlusion(rhs.occlusion), layoutAndFactors(rhs.layoutAndFactors) { }
        int compare(const osg::StateAttribute& rhs) const override { return -1; }
        bool isTextureAttribute() const { return true; }

        //! The textures comprising the PBR material
        osg::ref_ptr<osg::Texture> albedo, normal, pbr, occlusion;
        //! Packed as (layout, roughness factor, AO strength, metallic factor).
        osg::Vec4 layoutAndFactors = osg::Vec4(PBRMaterial::DRAM, 1, 1, 1);
        Status status;

        //! Sets a wrap on all textures
        inline void setWrap(osg::Texture::WrapParameter wrap, osg::Texture::WrapMode mode) {
            if (albedo.valid()) albedo->setWrap(wrap, mode);
            if (normal.valid()) normal->setWrap(wrap, mode);
            if (pbr.valid()) pbr->setWrap(wrap, mode);
            if (occlusion.valid()) occlusion->setWrap(wrap, mode);
        }

        //! Populates this object from a PBRMaterial description
        Status load(const PBRMaterial& material, const osgDB::Options* options = nullptr);

        //! Texture units the standard program samples; unit 0 holds this descriptor.
        //! The Registry marks them off-limits to terrain unit reservations so no
        //! scene-wide sampler of another type can share them.
        enum StandardUnit { ALBEDO_UNIT = 1, NORMAL_UNIT = 2, PBR_UNIT = 3, OCCLUSION_UNIT = 4 };

        /**
         * Binds this material on a stateset for the standard PBR program: the
         * descriptor itself on unit 0 (read by Chonk), the component textures on
         * the standard units, and the factor and flag uniforms the program reads.
         * Install the program once on an ancestor with installProgram().
         */
        void install(osg::StateSet* stateSet);

        /**
         * Installs the shared standard PBR program and its sampler bindings on a
         * stateset, typically the root of a model whose materials were bound with
         * install(). The program is created once and reused everywhere, so no
         * shader generation happens per model.
         */
        static void installProgram(osg::StateSet* stateSet);

        //! The shared standard PBR program, created on first use.
        static VirtualProgram* getOrCreateProgram();

        //! True for the names of the standard program's shader functions.
        static bool isStandardProgramFunction(const std::string& name);
    };
}

OSGEARTH_SPECIALIZE_CONFIG(osgEarth::PBRMaterial);
