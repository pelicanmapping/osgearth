#pragma once
#include <osgEarth/GLUtils>
#include <osg/Program>

namespace osgEarth { namespace detail
{
    // Internal shared implementation for decal and vector screen-frustum grids.
    // Params must match FrustumGrid.h.glsl; callers own materialized buffers and serialize access per context/camera.
    // Requires a valid compute program; returns false when no dispatch or buffer update is necessary.
    template<typename Params>
    bool updateScreenSpaceGrid(osg::State& state, osg::Program* program,
        GLBuffer& parameters, GLBuffer& frustums, Params& params,
        const osg::Matrix& projection, const osg::Vec4i& viewport, unsigned pixels,
        unsigned paramsBinding, unsigned frustumsBinding, bool force = false)
    {
        osg::Matrixf inverse = osg::Matrix::inverse(projection);
        if (!force && params.viewport == viewport && params.invProjMatrix == inverse &&
            params.pixelsPerTile == pixels) return false;
        params.invProjMatrix = inverse;
        params.viewport = viewport;
        params.pixelsPerTile = pixels;
        params.numTiles.set((viewport.z() + pixels - 1) / pixels, (viewport.w() + pixels - 1) / pixels);
        parameters.uploadData(sizeof(Params), &params);
        frustums.bind();
        frustums.bufferData(std::size_t(params.numTiles.x()) * params.numTiles.y() * 4 * sizeof(osg::Vec4f),
            nullptr, GL_DYNAMIC_DRAW);
        program->apply(state);
        parameters.bindBufferBase(paramsBinding);
        frustums.bindBufferBase(frustumsBinding);
        state.get<osg::GLExtensions>()->glDispatchCompute(
            (params.numTiles.x() + 15) / 16, (params.numTiles.y() + 15) / 16, 1);
        return true;
    }
} }
