    /**
     * Node that renders a 3D-Tiles Tile
     */
    class OSGEARTH_EXPORT ThreeDTileNode : public osg::MatrixTransform, public LoadableNode
    {
    public:
        ThreeDTileNode(ThreeDTilesetNode* tileset, Tile* tile, bool immediateLoad, osgDB::Options* options);
        osg::BoundingSphere computeBound() const;

        bool hasContent();

        osg::Node* getContent();

        bool isContentReady();

        void resolveContent();

        void updateTracking(osgUtil::CullVisitor* cv);

        //! Starts loading this tile's content in the 3D Tiles job pool, compiling it with the given ICO (if any)
        //! before it is attached. Bypasses the tileset's request queue; returns false when nothing was started
        //! because the content is loaded, already requested, absent, or waiting out a retry after a failure.
        bool requestContent(osgUtil::IncrementalCompileOperation* ico);

        //! Abandons an outstanding content request (canceling the download if it is still running) so the
        //! tile can request it again later. Cull thread only.
        void cancelContentRequest();

        //! True while a content request has been made but its result has not been attached yet.
        bool isContentRequestPending() const;

        //! Called during cull by a parent that wants to draw this tile in its place. Touches the tile so it won't
        //! expire, queues requests for any content it is missing (at the given priority, higher loads first), and
        //! returns true once the tile can be drawn without leaving a hole: its content is loaded, the root of an
        //! external tileset it points to is drawable, or, for a tile with no content, its error is high enough for
        //! it to refine and all of its children are drawable.
        bool prepareForRefine(osgUtil::CullVisitor* cv, double priority);

        //! Distance from the eye to the closest point of the tile's bounding volume (box or region when it has
        //! one, otherwise its sphere), scaled by the cull visitor's LOD scale; 0 when the eye is inside.
        double getDistanceToTile(osgUtil::CullVisitor* cv);

        double computeScreenSpaceError(osgUtil::CullVisitor* cv);

        void traverse(osg::NodeVisitor& nv);

        bool unloadContent();

        const Tile* getTile() const { return _tile.get(); }

        RefinePolicy getRefinePolicy() const { return _refine; }

        unsigned int getLastCulledFrameNumber() const;
        float getLastCulledFrameTime() const;

        virtual void resizeGLObjectBuffers(unsigned int maxSize);

        virtual void releaseGLObjects(osg::State* state) const;

        typedef std::list< osg::ref_ptr < ThreeDTileNode > > TileTracker;

        TileTracker::iterator _trackerItr;
        bool _trackerItrValid;

        void setParentTile(ThreeDTileNode* parentTile);

    public: // LoadableNode

        void load() override
        {
            // Load the content for this tile and attempt to resolve it.
            requestContent(nullptr);
            resolveContent();

            // If this tile has children we also need to load their content so this node is ready to subdivide
            if (_children.valid())
            {
                for (unsigned int i = 0; i < _children->getNumChildren(); i++)
                {
                    osg::ref_ptr< ThreeDTileNode > childTile = dynamic_cast<ThreeDTileNode*>(_children->getChild(i));
                    if (childTile.valid())
                    {
                        if (childTile->hasContent() && !childTile->isContentReady())
                        {
                            childTile->requestContent(nullptr);   
                            childTile->resolveContent();
                        }
                    }
                }
            }
        }

        void unload() override
        {
            unloadContent();
        }

        bool isHighestResolution() const override
        {
            return getNumChildren() == 0;
        }

        bool isLoadComplete() const override
        {
            auto t = const_cast<ThreeDTileNode*>(this);

            // Check to see if the content of this tile is loaded.
            bool isContentReady = false;
            if (t->hasContent())
            {
                isContentReady = t->isContentReady();
            }

            // If this tile has children, check to make sure it's content is loaded as well.  This will allow this tile to subdivide property.
            bool areChildrenReady = true;
            if (_children.valid())
            {
                for (unsigned int i = 0; i < _children->getNumChildren(); i++)
                {
                    osg::ref_ptr< ThreeDTileNode > childTile = dynamic_cast<ThreeDTileNode*>(_children->getChild(i));
                    if (childTile.valid())
                    {
                        if (childTile->hasContent() && !childTile->isContentReady())
                        {
                            areChildrenReady = false;
                        }
                    }
                }
            }

            return areChildrenReady && isContentReady;
        }

        bool getAutoUnload() const override
        {
            return _autoUnload;
        }

        void setAutoUnload(bool value) override
        {
            _autoUnload = value;
        }


    private:

        void createDebugBounds();

        void computeBoundingVolume();

        osg::ref_ptr< Tile > _tile;

        osg::ref_ptr< osg::Node > _content;
        osg::ref_ptr< osg::Group > _children;

        osg::ref_ptr< osg::Node > _boundsDebug;
        ThreeDTilesetNode* _tileset;

        Threading::Future< osg::ref_ptr<osg::Node> > _contentFuture;
        bool _requestedContent;

        bool _immediateLoad;

        bool _firstVisit;

        //! Load priority (higher first) for this tile's refinement: its screen-space error, weighted toward
        //! tiles near the center of the view.
        double computeLoadPriority(const osg::Matrixd& modelView, double error) const;

        osg::BoundingBoxd _boundingBox;
        osg::Matrixd _boundingBoxLocalToWorld;

        // Bounding sphere in the tile's (content) coordinate frame, in double precision for ECEF tiles.
        osg::BoundingSphered _localBoundingSphere;

        // Content load failures and when the content may be requested again (osg::Timer seconds).
        unsigned _loadFailures = 0u;
        double _retryTime = 0.0;

        osg::ref_ptr< osgDB::Options > _options;

        osg::Vec4 _debugColor;

        unsigned int _lastCulledFrameNumber;
        float _lastCulledFrameTime;

        bool _autoUnload = true;

        RefinePolicy _refine;

        osg::observer_ptr< ThreeDTileNode > _parentTile;
    };

    /**
    * Node representing a 3D-Tiles Tileset.
    */
    class OSGEARTH_EXPORT ThreeDTilesetNode : public osg::Group
    {
    public:
        //! Optional model conversion, called before GL compilation for immediate and paged content, including
        //! external tilesets' models. Must support concurrent calls and retain any resources it needs.
        //! Returns the model to publish, or null to fail the load. Never receives a tileset hierarchy.
        using ContentProcessor = std::function<osg::ref_ptr<osg::Node>(osg::Node*)>;

        //! Constructs the tileset and loads its root, optionally converting models with processContent.
        ThreeDTilesetNode(Tileset* tileset, const std::string& authorizationHeader,
            SceneGraphCallbacks* sceneGraphCallbacks, osgDB::Options* options,
            const ContentProcessor& processContent = ContentProcessor());

        float getMaximumScreenSpaceError() const;
        void setMaximumScreenSpaceError(float maximumScreenSpaceError);

        double getSSEDenominator() const;

        void touchTile(ThreeDTileNode* node);

        void traverse(osg::NodeVisitor& nv);

        const Tileset* getTileset() const { return _tileset.get(); }

        const osgDB::Options* getOptions() const { return _options.get(); }

        const std::string& getAuthorizationHeader() const { return _authorizationHeader; }
        void setAuthorizationHeader(const std::string& authorizationHeader) { _authorizationHeader = authorizationHeader; }

        //! Get the scene graph callback host
        SceneGraphCallbacks* getSceneGraphCallbacks(SceneGraphCallbacks* callbacks);

        //! Set the scene graph callback host
        void setSceneGraphCallbacks(SceneGraphCallbacks* callbacks);

        void runPreMergeOperations(osg::Node* node);
        void runPostMergeOperations(osg::Node* node);

        /**
         * Gets/sets the maximum number of tiles to keep in memory before expiring them.
         */
        unsigned int getMaxTiles() const;
        void setMaxTiles(unsigned int maxTiles);

        /**
         * Gets/sets the max age of tiles before they are considered for expiration.
         */
        float getMaxAge() const;
        void setMaxAge(float maxAge);

        /**
         * Gets/sets how many tile content loads (download, parse and texture preparation) may run at once.
         * Defaults to 20, or the OSGEARTH_3DTILES_MAX_LOADS environment variable. The shared 3D Tiles job pool
         * grows to at least this many threads.
         */
        unsigned int getMaxSimultaneousLoads() const;
        void setMaxSimultaneousLoads(unsigned int value);

        /**
         * Asks for a tile's content to be loaded. During this tileset's cull traversal the request is queued;
         * when the traversal finishes, the queued requests are ranked by priority (higher first) and only as many
         * are started as there are free load slots. The rest are dropped and asked for again by the next frame,
         * so the queue always reflects the current view. Outside a cull the load starts immediately.
         */
        void requestTileContent(ThreeDTileNode* node, double priority);

        /**
         * Turns on/off bounding volume visualization.
         */
        bool getShowBoundingVolumes() const;
        void setShowBoundingVolumes(bool showBoundingVolumes);

        /**
         * Turns on/off rendering a debug color per tile.
         */
        bool getColorPerTile() const;
        void setColorPerTile(bool colorPerTile);

        const std::string& getOwnerName() const;
        void setOwnerName(const std::string& name);

    private:
        friend class ThreeDTileNode;

        void expireTiles(const osg::NodeVisitor& nv);

        //! A load slot, held by a content job for as long as it exists; releasing it frees the slot.
        std::shared_ptr<void> acquireLoadSlot();

        //! Cancels in-flight requests for tiles no culls have visited recently.
        void cancelStaleRequests(double frameTime);

        //! Ranks the requests queued by one cull traversal and starts as many as there are free load slots.
        void dispatchRequests(std::vector<std::pair<double, ThreeDTileNode*>>& requests,
            osgUtil::IncrementalCompileOperation* ico, double frameTime);

        const ContentProcessor _processContent;
        osg::ref_ptr<Tileset> _tileset;
        osg::ref_ptr<osgDB::Options> _options;
        float _maximumScreenSpaceError;

        mutable std::mutex _mutex;
        ThreeDTileNode::TileTracker _tracker;
        ThreeDTileNode::TileTracker::iterator _sentryItr;

        unsigned int _maxTiles;
        float _maxAge;

        unsigned int _maxSimultaneousLoads;
        std::shared_ptr<std::atomic_uint> _loadsInFlight;

        // Tiles whose loads were started from the request queue, so stale ones can be canceled.
        std::mutex _loadingMutex;
        std::vector<osg::observer_ptr<ThreeDTileNode>> _loading;

        bool _showBoundingVolumes;
        bool _showColorPerTile;

        osg::ref_ptr< VirtualProgram> _debugVP;

        unsigned int _lastExpiredFrame;

        double _sseDenominator;

        std::string _authorizationHeader;

        osg::ref_ptr<SceneGraphCallbacks> _sgCallbacks;

        std::string _ownerName;
    };

