#pragma once
#include <osgEarthImGui/ImGuiPanel>
#include <osgEarth/MapNode>
#include <osgEarth/EarthManipulator>
#include <osgEarth/NavigationManipulators>
#include <atomic>
#include <cmath>

namespace osgEarth
{
    using namespace osgEarth::Util;

    /**
     * Camera mode selection and settings for dedicated map, fly, walk, and drive manipulators.
     */
    struct CameraGUI : public ImGuiPanel
    {
        // Shared with the GUI; camera changes run only during the view's event traversal.
        struct OrbitHandler : public osgGA::GUIEventHandler
        {
            std::atomic<bool> enabled{ false };
            std::atomic<float> degreesPerSecond{ 1.5f };
            std::atomic<bool> autoZoom{ false };
            std::atomic<float> zoomPeriodSeconds{ 45.0f };
            std::atomic<float> zoomSpreadPercent{ 25.0f };

            //! Observe the target without extending its lifetime or retaining the panel.
            explicit OrbitHandler(EarthManipulator* manipulator) : _manipulator(manipulator) { }

            //! Advance heading and optional sine-wave range on frame events; inactive or invalid targets do not move.
            bool handle(const osgGA::GUIEventAdapter& ea, osgGA::GUIActionAdapter& aa) override
            {
                if (ea.getEventType() != osgGA::GUIEventAdapter::FRAME)
                    return false;

                auto* currentView = dynamic_cast<osgViewer::View*>(&aa);
                osg::ref_ptr<EarthManipulator> manipulator;
                if (!_manipulator.lock(manipulator) || !currentView ||
                    currentView->getCameraManipulator() != manipulator.get())
                {
                    enabled = false;
                    _wasEnabled = false;
                    _wasAutoZooming = false;
                    return false;
                }

                double now = ea.getTime();
                double elapsed = now - _lastTime;
                bool running = enabled.load();
                bool zooming = running && autoZoom.load();
                if (!zooming)
                    _wasAutoZooming = false;
                if (running && _wasEnabled && std::isfinite(elapsed) && elapsed > 0.0)
                {
                    auto vp = manipulator->getViewpoint();
                    if (vp.valid())
                    {
                        // Copy the full viewpoint to preserve focal point, tether, pitch, and offsets.
                        double heading = vp.heading()->as(Units::DEGREES) + elapsed * degreesPerSecond.load();
                        vp.heading() = Angle(std::remainder(heading, 360.0), Units::DEGREES);
                        if (zooming)
                        {
                            double range = vp.range()->as(Units::METERS);
                            if (std::isfinite(range) && range > 0.0)
                            {
                                // Anchor each run to its starting range; never compound the sine-wave scale.
                                // Start at the current range and leave it in place when either toggle is disabled.
                                if (!_wasAutoZooming)
                                {
                                    _zoomBaseRange = range;
                                    _zoomPhase = 0.0;
                                }
                                else
                                {
                                    // Keep phase continuous when changing speed, independent of orbit speed.
                                    _zoomPhase = std::fmod(_zoomPhase + elapsed * (2.0 * osg::PI / zoomPeriodSeconds.load()),
                                        2.0 * osg::PI);
                                }
                                double spread = zoomSpreadPercent.load() * 0.01;
                                vp.range() = Distance(_zoomBaseRange * (1.0 - spread * std::sin(_zoomPhase)),
                                    Units::METERS);
                                _wasAutoZooming = true;
                            }
                            else
                                _wasAutoZooming = false;
                        }
                        manipulator->setViewpoint(vp, 0.0);
                    }
                    else
                        _wasAutoZooming = false;
                }
                _lastTime = now;
                _wasEnabled = running && std::isfinite(now);
                if (running)
                    aa.requestRedraw();
                return false;
            }

        private:
            osg::observer_ptr<EarthManipulator> _manipulator;
            double _lastTime = 0.0;
            bool _wasEnabled = false;
            bool _wasAutoZooming = false;
            double _zoomBaseRange = 0.0;
            double _zoomPhase = 0.0;
        };

        double _vfov, _ar, _zn, _zf;
        osg::ref_ptr<EarthManipulator::Settings> _settings;
        Config _loadConf;
        osg::observer_ptr<osgViewer::View> _view;
        osg::observer_ptr<EarthManipulator> _manipulator;
        osg::ref_ptr<OrbitHandler> _orbit;
        osg::observer_ptr<NavigationModeHandler> _navigation;
        osg::observer_ptr<GamepadHandler> _gamepad;
        float _orbitSpeed = 1.5f;
        float _zoomPeriodSeconds = 45.0f;
        float _zoomSpreadPercent = 25.0f;

        CameraGUI() :
            ImGuiPanel("Camera"),
            _vfov(30), _ar(1), _zn(1), _zf(100)
        {
            //nop
        }

        //! Stop and detach the frame handler when the GUI panel is destroyed.
        ~CameraGUI() override
        {
            detachOrbit();
        }

        //! Release the old view binding on the GUI thread; an in-flight handler remains safely disabled.
        void detachOrbit()
        {
            if (_orbit)
            {
                _orbit->enabled = false;
                osg::ref_ptr<osgViewer::View> previous;
                if (_view.lock(previous))
                    previous->removeEventHandler(_orbit.get());
                _orbit = nullptr;
            }
        }

        //! Refresh bindings even while hidden, stopping orbit when the view or manipulator changes.
        void update(osg::RenderInfo& ri) override
        {
            auto* currentView = view(ri);
            _navigation = nullptr;
            _gamepad = nullptr;
            if (currentView)
            {
                for (const auto& handler : currentView->getEventHandlers())
                {
                    if (auto* modes = dynamic_cast<NavigationModeHandler*>(handler.get())) _navigation = modes;
                    if (auto* pad = dynamic_cast<GamepadHandler*>(handler.get())) _gamepad = pad;
                }
            }
            auto* man = currentView ? dynamic_cast<EarthManipulator*>(currentView->getCameraManipulator()) : nullptr;
            if (_view.get() != currentView || _manipulator.get() != man)
            {
                detachOrbit();
                _view = currentView;
                _manipulator = man;
                if (man)
                {
                    _orbit = new OrbitHandler(man);
                    _orbit->degreesPerSecond = _orbitSpeed;
                    _orbit->zoomPeriodSeconds = _zoomPeriodSeconds;
                    _orbit->zoomSpreadPercent = _zoomSpreadPercent;
                    currentView->addEventHandler(_orbit.get());
                }
            }
            _settings = man ? man->getSettings() : nullptr;
        }

        void load(const Config& conf) override
        {
            // remember, the settings come in one at a time so we have to use merge
            _loadConf.merge(conf);
        }

        void save(Config& conf) override
        {
            if (_settings)
            {
                conf.set("SingleAxisRotation", _settings->singleAxisRotation());
                conf.set("LockAzimuthWhilePanning", _settings->lockAzimuthWhilePanning());
                conf.set("TerrainAvoidance", _settings->terrainAvoidanceEnabled());
                conf.set("Throwing", _settings->throwingEnabled());
                conf.set("ThrowingDecay", _settings->throwDecayRate());
                conf.set("ZoomToMouse", _settings->zoomToMouse());
            }
        }

        //! Draw mode and input controls; return true after drawing an eye-centered mode's settings.
        bool drawNavigation(osg::RenderInfo& ri)
        {
            osg::ref_ptr<NavigationModeHandler> modes;
            if (!_navigation.lock(modes)) return false;
            auto* navigation = dynamic_cast<NavigationManipulator*>(
                modes->getManipulator(modes->getMode()));
            auto* drive = dynamic_cast<DriveManipulator*>(navigation);
            auto* fly = dynamic_cast<FlyManipulator*>(navigation);
            osg::ref_ptr<GamepadHandler> pad;
#ifdef _WIN32
            _gamepad.lock(pad);
#endif
            if (ImGuiLTable::Begin("CameraNavigation"))
            {
                const char* names[] = { "Map", "Fly", "Walk", "Drive" };
                const int mode = static_cast<int>(modes->getMode());
                if (ImGuiLTable::BeginCombo("Navigation mode", names[mode]))
                {
                    for (int i = 0; i < 4; ++i)
                    {
                        if (ImGui::Selectable(names[i], i == mode))
                        {
                            if (_orbit) _orbit->enabled = false;
                            modes->requestMode(static_cast<NavigationModeHandler::Mode>(i));
                            view(ri)->requestRedraw();
                        }
                        if (i == mode) ImGui::SetItemDefaultFocus();
                    }
                    ImGuiLTable::EndCombo();
                }
                if (pad)
                {
                    bool enabled = pad->getEnabled();
                    if (ImGuiLTable::Checkbox("Gamepad", &enabled)) pad->setEnabled(enabled);
                }
                if (navigation)
                {
                    bool altitudeSpeed = fly && fly->getAutoSpeedEnabled();
                    if (fly && ImGuiLTable::Checkbox("Altitude speed", &altitudeSpeed))
                        fly->setAutoSpeedEnabled(altitudeSpeed);
                    float speed = static_cast<float>(navigation->getSpeed() * (drive ? 3.6 : 1.0));
                    if (ImGuiLTable::SliderFloat(drive ? "Top speed (km/h)" :
                        altitudeSpeed ? "Speed at 1 km (m/s)" : "Speed (m/s)", &speed,
                        fly ? 1.0f : 0.1f, fly ? 10000.0f : drive ? 360.0f : 20.0f,
                        "%.1f", ImGuiSliderFlags_Logarithmic | ImGuiSliderFlags_AlwaysClamp))
                        navigation->setSpeed(speed / (drive ? 3.6 : 1.0));
                    if (fly) ImGuiLTable::Text("Full-stick speed", "%.1f m/s", fly->getEffectiveSpeed());
                    float lookSpeed = static_cast<float>(osg::RadiansToDegrees(navigation->getLookSpeed()));
                    if (ImGuiLTable::SliderFloat("Look speed (deg/s)",
                        &lookSpeed, 10.0f, 240.0f, "%.0f", 0))
                        navigation->setLookSpeed(osg::DegreesToRadians(lookSpeed));
                    float height = static_cast<float>(navigation->getEyeHeight());
                    if (ImGuiLTable::SliderFloat(fly ? "Terrain clearance (m)" : "Eye height (m)",
                        &height, 0.2f, 10.0f, "%.1f", 0))
                        navigation->setEyeHeight(height);
                    if (drive)
                    {
                        float acceleration = static_cast<float>(drive->getAcceleration());
                        if (ImGuiLTable::SliderFloat("Acceleration (m/s2)", &acceleration, 0.5f, 15.0f, "%.1f", 0))
                            drive->setAcceleration(acceleration);
                        ImGuiLTable::Text("Speed", "%.1f km/h", drive->getVelocity() * 3.6);
                    }
                }
                ImGuiLTable::End();
            }
            if (pad && pad->getEnabled())
            {
                if (pad->getController() >= 0) ImGui::Text("XInput controller %d", pad->getController() + 1);
                else ImGui::TextDisabled("Waiting for an XInput controller");
                ImGui::TextWrapped("Release sticks, triggers and A after changing modes or returning to the window.");
            }
            if (!navigation) return false;
            ImGui::Separator();
            if (drive)
            {
                ImGui::TextWrapped("Left stick: steer. RT: throttle. LT: brake, then reverse.");
                ImGui::TextWrapped("Right stick: look left/right up to 90 degrees; release to ease back forward. Up/down: pitch.");
                ImGui::TextWrapped("Keyboard: W/S pedals, A/D steer. Hold arrows or right mouse drag to look.");
                ImGui::TextWrapped("Release horizontal look to smoothly recenter on the vehicle heading.");
            }
            else
            {
                ImGui::TextWrapped("Left stick or WASD: move and strafe. Right stick, arrows or right mouse drag: look.");
                if (fly)
                {
                    ImGui::TextWrapped("RT/E: ascend. LT/Q: descend.");
                    ImGui::TextWrapped("Altitude speed scales flight speed with height above terrain.");
                }
            }
            ImGui::TextWrapped("LB/Ctrl: slow. RB/Shift: fast. A/Home: return to this mode's entry position.");
            if (!fly)
            {
                ImGui::TextWrapped("Follows terrain beneath the camera; buildings and other obstacles are not colliders.");
                if (!navigation->hasGround()) ImGui::TextDisabled("Waiting for loaded terrain beneath the camera");
            }
            return true;
        }

        void draw(osg::RenderInfo& ri)
        {
            if (!isVisible())
                return;

            osg::observer_ptr<MapNode> mapNode;
            if (!findNodeOrHide<MapNode>(mapNode, ri))
                return;

            update(ri);
            auto* man = _manipulator.get();
            if (man)
            {
                _settings = man->getSettings();
                if (_settings && !_loadConf.empty())
                {
                    _loadConf.get("SingleAxisRotation", _settings->singleAxisRotation());
                    _loadConf.get("LockAzimuthWhilePanning", _settings->lockAzimuthWhilePanning());
                    _loadConf.get("TerrainAvoidance", _settings->terrainAvoidanceEnabled());
                    _loadConf.get("Throwing", _settings->throwingEnabled());
                    _loadConf.get("ThrowingDecay", _settings->throwDecayRate());
                    _loadConf.get("ZoomToMouse", _settings->zoomToMouse());
                    _loadConf = {};
                }
            }

            ImGui::Begin(name(), visible());
            if (drawNavigation(ri))
            {
                ImGui::End();
                return;
            }
            if (!_settings)
            {
                ImGui::TextColored(ImVec4(1, 0, 0, 1), "No earth manipulator");
                ImGui::End();
                return;
            }

            {
                if (ImGuiLTable::Begin("CameraGUI"))
                {
                    bool orbit = _orbit->enabled.load();
                    if (ImGuiLTable::Checkbox("Orbit", &orbit))
                    {
                        _orbit->enabled = orbit;
                        view(ri)->requestRedraw();
                    }
                    if (orbit && ImGuiLTable::SliderFloat("Orbit speed (deg/s)", &_orbitSpeed,
                        0.1f, 30.0f, "%.1f", ImGuiSliderFlags_AlwaysClamp))
                    {
                        _orbit->degreesPerSecond = _orbitSpeed;
                    }
                    if (orbit)
                    {
                        bool autoZoom = _orbit->autoZoom.load();
                        if (ImGuiLTable::Checkbox("Auto-zoom", &autoZoom))
                            _orbit->autoZoom = autoZoom;
                        if (autoZoom)
                        {
                            if (ImGuiLTable::SliderFloat("Zoom cycle (seconds)", &_zoomPeriodSeconds,
                                5.0f, 120.0f, "%.1f", ImGuiSliderFlags_AlwaysClamp))
                            {
                                _orbit->zoomPeriodSeconds = _zoomPeriodSeconds;
                            }
                            if (ImGui::IsItemHovered())
                                ImGui::SetTooltip("Time for a full zoom-in/zoom-out cycle. Lower is faster.");
                            if (ImGuiLTable::SliderFloat("Zoom spread (%)", &_zoomSpreadPercent,
                                0.0f, 90.0f, "+/- %.0f%%", ImGuiSliderFlags_AlwaysClamp))
                            {
                                _orbit->zoomSpreadPercent = _zoomSpreadPercent;
                            }
                            if (ImGui::IsItemHovered())
                                ImGui::SetTooltip("Percentage above and below the range when auto-zoom starts.");
                        }
                    }

                    osg::Matrix pm = camera(ri)->getProjectionMatrix();
                    bool ortho = ProjectionMatrix::isOrtho(pm);
                    if (ImGuiLTable::Checkbox("Orthographic", &ortho))
                    {
                        if (ortho) {
                            ProjectionMatrix::getPerspective(pm, _vfov, _ar, _zn, _zf);
                            ProjectionMatrix::setOrtho(pm, -1, 1, -1, 1, _zn, _zf);
                        }
                        else {
                            ProjectionMatrix::setPerspective(pm, _vfov, _ar, _zn, _zf);
                        }
                        camera(ri)->setProjectionMatrix(pm);
                    }

                    if (_settings)
                    {
                        if (ImGuiLTable::Checkbox("Lock azimuth", &_settings->lockAzimuthWhilePanning()))
                            dirtySettings();

                        if (ImGuiLTable::Checkbox("Avoid terrain", &_settings->terrainAvoidanceEnabled()))
                            dirtySettings();

                        if (ImGuiLTable::Checkbox("Zoom to mouse", &_settings->zoomToMouse()))
                            dirtySettings();

                        if (ImGuiLTable::Checkbox("Throwing", &_settings->throwingEnabled()))
                            dirtySettings();

                        if (_settings->getThrowingEnabled())
                        {
                            if (ImGuiLTable::SliderDouble("Decay", &_settings->throwDecayRate(), 0.0f, 0.3f))
                                dirtySettings();
                        }
                    }

                    static float magnification_old = 1.0f, magnification_new = 1.0f;
                    static osg::Matrix ref_proj;
                    if (ImGuiLTable::SliderFloat("Magnification", &magnification_new, 1.0f, 50.0f))
                    {
                        auto proj = camera(ri)->getProjectionMatrix();
                        if (magnification_old == 1.0f ||
                            ref_proj.isIdentity() ||
                            ProjectionMatrix::isOrtho(proj) != ProjectionMatrix::isOrtho(ref_proj))
                        {
                            ref_proj = proj;
                        }

                        double rangeScale = 1.0 / magnification_new;

                        osg::Matrix new_proj;
                        if (ProjectionMatrix::isPerspective(ref_proj))
                        {
                            double vfov, ar, n, f;
                            ProjectionMatrix::getPerspective(ref_proj, vfov, ar, n, f);
                            ProjectionMatrix::setPerspective(new_proj, vfov * rangeScale, ar, n, f);
                            _settings->setOrthoTracksPerspective(true);
                        }
                        else
                        {
                            double L, R, B, T, N, F;
                            double M, H;
                            ProjectionMatrix::getOrtho(ref_proj, L, R, B, T, N, F);
                            M = B + (T - B) / 2;
                            H = (T - B) * rangeScale / 2;
                            B = M - H, T = M + H;
                            M = L + (R - L) / 2;
                            H = (R - L) * rangeScale / 2;
                            L = M - H, R = M + H;
                            ProjectionMatrix::setOrtho(new_proj, L, R, B, T, N, F);
                            _settings->setOrthoTracksPerspective(false);
                        }

                        camera(ri)->setProjectionMatrix(new_proj);

                        // PagedNode2:
                        // it works with this in BOTH camera_distance (expected) AND screen_space (UNexpected) modes.
                        // it does NOT work WITHOUT this in screen_space mode (unexcpected).

                        if (mapNode->getTerrainOptions().getLODMethod() == LODMethod::CAMERA_DISTANCE)
                            camera(ri)->setLODScale(rangeScale);
                        else
                            camera(ri)->setLODScale(1.0f);

                        magnification_old = magnification_new;
                    }

                    if (!ortho)
                    {
                        static osg::CullSettings::ComputeNearFarMode old_near_far_mode = osg::CullSettings::DO_NOT_COMPUTE_NEAR_FAR;
                        static bool lock_far_clip = false;
                        static float locked_far_clip = 0.0f;
                        if (ImGuiLTable::Checkbox("Lock far clip", &lock_far_clip))
                        {
                            if (lock_far_clip)
                            {
                                old_near_far_mode = camera(ri)->getComputeNearFarMode();
                                double L, R, B, T, N, F;
                                camera(ri)->getProjectionMatrixAsFrustum(L, R, B, T, N, F);
                                locked_far_clip = F;
                                camera(ri)->setComputeNearFarMode(osg::Camera::DO_NOT_COMPUTE_NEAR_FAR);
                                camera(ri)->setProjectionMatrixAsFrustum(L, R, B, T, N, F);
                            }
                            else
                            {
                                camera(ri)->setComputeNearFarMode(old_near_far_mode);
                            }
                        }
                    }

                    auto& proj = camera(ri)->getProjectionMatrix();
                    if (ProjectionMatrix::isPerspective(proj))
                    {
                        ImGui::Separator();
                        double vfov, ar, n, f;
                        ProjectionMatrix::getPerspective(proj, vfov, ar, n, f);
                        ImGuiLTable::Text("VFOV", "%.2f", vfov);
                        ImGuiLTable::Text("Near", "%.2f", n);
                        ImGuiLTable::Text("Far", "%.1f", f);
                    }

                    ImGuiLTable::End();
                }
            }

            ImGui::End();
        }
    };
}
