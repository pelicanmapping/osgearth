#pragma once

#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>

namespace osgEarth
{
    struct HeapHotspotFrame
    {
        std::string file;
        std::string function;
        std::uint32_t line = 0;
        std::uintptr_t address = 0;
    };

    struct HeapHotspotSite
    {
        // Stable for the same resolved site so consumers can correlate snapshots.
        std::uint64_t id = 0;
        std::string file;
        std::string function;
        std::uint32_t line = 0;
        std::uint64_t liveBytes = 0;
        std::uint64_t liveAllocations = 0;
        std::uint64_t largestAllocation = 0;
        std::vector<HeapHotspotFrame> callStack;

        // Raw stack IDs folded into this resolved site. This lets live views
        // carry observations made before symbol resolution into the site.
        std::vector<std::uint64_t> allocationStackIds;
    };

    struct HeapHotspotLiveSite
    {
        std::uint64_t id = 0;
        std::uint64_t liveBytes = 0;
        std::uint64_t liveAllocations = 0;
        std::uintptr_t topAddress = 0;
        bool resolved = false;
    };

    struct HeapHotspotLiveSnapshot
    {
        bool valid = false;
        std::string error;
        std::uint64_t liveBytes = 0;
        std::uint64_t liveAllocations = 0;
        std::vector<HeapHotspotLiveSite> sites;
    };

    struct HeapHotspotLineMetrics
    {
        std::uint32_t line = 0;
        std::uint64_t directLiveBytes = 0;
        std::uint64_t directLiveAllocations = 0;
        std::uint64_t inclusiveLiveBytes = 0;
        std::uint64_t inclusiveLiveAllocations = 0;
    };

    struct HeapHotspotSourceFile
    {
        std::string path;
        std::vector<HeapHotspotLineMetrics> lines;
    };

    enum class HeapRecommendationKind : std::uint8_t
    {
        AllocationChurn,
        RepeatedReallocation,
        ShortLivedLargeAllocation
    };

    struct HeapRecommendation
    {
        HeapRecommendationKind kind = HeapRecommendationKind::AllocationChurn;
        std::string file;
        std::string function;
        std::uint32_t line = 0;
        std::vector<HeapHotspotFrame> callStack;

        std::uint64_t eventCount = 0;
        std::uint64_t totalBytes = 0;
        std::uint64_t estimatedBytesCopied = 0;
        std::uint64_t maximumReallocationChain = 0;
        std::uint64_t lifetimeThresholdMilliseconds = 0;
        std::uint64_t sizeThresholdBytes = 0;
        double averageLifetimeMilliseconds = 0.0;
        double eventsPerSecond = 0.0;
        double score = 0.0;
    };

    // Immutable-by-convention snapshot returned by the heap diagnostics API.
    // All byte values are raw bytes so consumers can choose their own units.
    struct HeapHotspotReport
    {
        bool valid = false;
        std::string error;

        std::size_t allocationThreshold = 0;
        std::uint32_t patchedModules = 0;
        std::size_t distinctCallStacks = 0;

        std::uint64_t trackedHeapBytes = 0;
        std::uint64_t trackedHeapAllocations = 0;
        std::uint64_t trackedVirtualBytes = 0;
        std::uint64_t trackedVirtualRegions = 0;

        // Cumulative requested-byte traffic observed since install().
        // Successful reallocations free the old size and allocate the new size.
        std::uint64_t cumulativeAllocatedBytes = 0;
        std::uint64_t cumulativeFreedBytes = 0;

        std::size_t processHeapCount = 0;
        bool processHeapWalkComplete = false;
        std::uint64_t rawHeapBytes = 0;
        std::uint64_t rawHeapBlocks = 0;
        std::uint64_t heapBlockOverheadBytes = 0;
        std::uint64_t profilerBytes = 0;
        std::uint64_t profilerBlocks = 0;
        std::uint64_t applicationHeapBytes = 0;
        std::uint64_t applicationHeapBlocks = 0;
        std::uint64_t untrackedApplicationHeapBytes = 0;
        double heapCoveragePercent = 0.0;

        std::uint64_t heapCommittedBytes = 0;
        bool heapCommittedIsEstimate = false;
        std::uint64_t heapSegmentBackingBytes = 0;
        std::uint64_t standaloneLargeBlockBackingBytes = 0;

        bool processPrivateBytesAvailable = false;
        std::uint64_t processPrivateBytes = 0;
        double knownMemoryCategoriesPercent = 0.0;

        std::vector<HeapHotspotSite> sites;
        std::vector<HeapHotspotSourceFile> sourceFiles;
        std::vector<HeapRecommendation> recommendations;

        std::uint64_t trackedBytes() const noexcept
        {
            return trackedHeapBytes + trackedVirtualBytes;
        }

        std::uint64_t trackedAllocations() const noexcept
        {
            return trackedHeapAllocations + trackedVirtualRegions;
        }
    };
}
