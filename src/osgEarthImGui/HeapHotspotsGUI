    class HeapHotspotsGUI : public ImGuiPanel
    {
    public:
        using CaptureFunction = std::function<HeapHotspotReport()>;
        using LiveCaptureFunction = std::function<HeapHotspotLiveSnapshot()>;
        using TrackingSuppressionFunction = std::function<void(bool)>;
        using WriteFunction = std::function<
            bool(const HeapHotspotReport&, const std::string&)>;

        HeapHotspotsGUI(
            CaptureFunction capture,
            WriteFunction write = {},
            LiveCaptureFunction liveCapture = {},
            TrackingSuppressionFunction trackingSuppression = {}) :
            ImGuiPanel("Heap Hotspots"),
            _capture(std::move(capture)),
            _write(std::move(write)),
            _liveCapture(std::move(liveCapture)),
            _trackingSuppression(std::move(trackingSuppression))
        {
        }

        void draw(osg::RenderInfo&) override
        {
            if (!isVisible())
                return;

            TrackingSuppressionGuard suppression(_trackingSuppression);
            ImGui::Begin(name(), visible());
            drawContents();
            ImGui::End();
        }

    private:
        class TrackingSuppressionGuard
        {
        public:
            explicit TrackingSuppressionGuard(
                const TrackingSuppressionFunction& function) noexcept :
                _function(function ? &function : nullptr)
            {
                if (_function)
                {
                    try
                    {
                        (*_function)(true);
                        _active = true;
                    }
                    catch (...)
                    {
                        _function = nullptr;
                    }
                }
            }

            ~TrackingSuppressionGuard()
            {
                if (_active)
                {
                    try
                    {
                        (*_function)(false);
                    }
                    catch (...)
                    {
                    }
                }
            }

            TrackingSuppressionGuard(const TrackingSuppressionGuard&) = delete;
            TrackingSuppressionGuard& operator=(
                const TrackingSuppressionGuard&) = delete;

        private:
            const TrackingSuppressionFunction* _function = nullptr;
            bool _active = false;
        };

        struct SitePeakHistory
        {
            std::uint64_t siteId = 0;
            std::uint64_t peakBytes = 0;
            std::uint64_t peakAllocations = 0;
            std::uint64_t bytesPeakEvents = 0;
            std::uint64_t allocationsPeakEvents = 0;
            double bytesPeakTime = -1000.0;
            double allocationsPeakTime = -1000.0;
            std::uint64_t firstSeenOrder = 0;
        };

        struct ActivityRow
        {
            std::uint64_t siteId = 0;
            std::uint64_t currentBytes = 0;
            std::uint64_t currentAllocations = 0;
            std::uintptr_t topAddress = 0;
            std::size_t siteIndex = static_cast<std::size_t>(-1);
            std::size_t historyIndex = 0;
            bool resolved = false;
        };

        struct ResolvedSiteIndex
        {
            std::uint64_t siteId = 0;
            std::size_t siteIndex = 0;
        };

        CaptureFunction _capture;
        WriteFunction _write;
        LiveCaptureFunction _liveCapture;
        TrackingSuppressionFunction _trackingSuppression;
        HeapHotspotReport _report;
        HeapHotspotLiveSnapshot _liveSnapshot;
        ImGuiTextFilter _filter;
        int _sort = 0;
        bool _sortDescending = true;
        std::size_t _selectedSite = static_cast<std::size_t>(-1);
        std::size_t _selectedRecommendation = static_cast<std::size_t>(-1);
        std::string _status;
        std::string _liveStatus;

        std::vector<SitePeakHistory> _sitePeakHistory;
        std::vector<SitePeakHistory> _pendingPeakHistory;
        std::vector<ActivityRow> _activityRows;
        std::vector<ActivityRow> _pendingActivityRows;
        std::vector<std::size_t> _visibleActivityRows;
        std::vector<ResolvedSiteIndex> _resolvedSiteIndices;
        int _activityMetric = 0; // 0=live bytes, 1=allocation count
        int _activitySort = 0; // 0=stable, 1=current, 2=peak, 3=events, 4=site
        bool _activitySortDescending = false;
        std::uint64_t _nextActivityOrder = 0;
        bool _showInactiveActivitySites = true;
        double _minimumActiveMiB = 0.0;
        double _minimumPeakMiB = 0.0;
        int _minimumActiveAllocations = 0;
        int _minimumPeakAllocations = 0;
        float _liveSampleInterval = 0.1f;
        double _nextLiveSampleTime = 0.0;
        bool _liveSamplingPaused = false;
        std::uint64_t _selectedActivitySiteId = 0;

        std::string _sourcePath;
        std::string _sourceError;
        std::vector<std::string> _sourceLines;
        std::vector<HeapHotspotLineMetrics> _sourceMetrics;
        float _sourceTextWidth = 0.0f;
        std::uint32_t _selectedSourceLine = 0;
        bool _selectSourceTab = false;
        bool _scrollToSourceLine = false;
        int _attributionMode = 0; // 0=inclusive stack, 1=direct allocation site

        static double toMiB(std::uint64_t bytes)
        {
            return static_cast<double>(bytes) / 1048576.0;
        }

        static std::string formatBytes(std::uint64_t bytes)
        {
            char text[64];
            if (bytes >= 1073741824)
                std::snprintf(text, sizeof(text), "%.2f GiB", static_cast<double>(bytes) / 1073741824.0);
            else if (bytes >= 1048576)
                std::snprintf(text, sizeof(text), "%.2f MiB", toMiB(bytes));
            else if (bytes >= 1024)
                std::snprintf(text, sizeof(text), "%.1f KiB", static_cast<double>(bytes) / 1024.0);
            else
                std::snprintf(text, sizeof(text), "%llu B", static_cast<unsigned long long>(bytes));
            return text;
        }

        static std::string normalizedPath(std::string path)
        {
            std::replace(path.begin(), path.end(), '/', '\\');
#ifdef _WIN32
            std::transform(
                path.begin(), path.end(), path.begin(),
                [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
#endif
            return path;
        }

        static std::string snapshotFilename()
        {
            const auto now = std::chrono::system_clock::now();
            const std::time_t time = std::chrono::system_clock::to_time_t(now);
            std::tm localTime = {};
#ifdef _WIN32
            localtime_s(&localTime, &time);
#else
            localtime_r(&time, &localTime);
#endif
            char timestamp[32];
            std::strftime(timestamp, sizeof(timestamp), "%Y%m%d-%H%M%S", &localTime);
            return std::string("heap-hotspots-") + timestamp + ".txt";
        }

        const HeapHotspotSourceFile* findSourceMetrics(const std::string& path) const
        {
            const std::string normalized = normalizedPath(path);
            const auto found = std::find_if(
                _report.sourceFiles.begin(), _report.sourceFiles.end(),
                [&](const HeapHotspotSourceFile& source)
                {
                    return normalizedPath(source.path) == normalized;
                });
            return found == _report.sourceFiles.end() ? nullptr : &*found;
        }

        void rebuildSourceMetrics()
        {
            _sourceMetrics.assign(_sourceLines.size() + 1, HeapHotspotLineMetrics());
            const HeapHotspotSourceFile* source = findSourceMetrics(_sourcePath);
            if (!source)
                return;

            for (const HeapHotspotLineMetrics& metrics : source->lines)
            {
                if (metrics.line < _sourceMetrics.size())
                    _sourceMetrics[metrics.line] = metrics;
            }
        }

        void openSource(const std::string& path, std::uint32_t line)
        {
            _sourcePath = path;
            _sourceError.clear();
            _sourceLines.clear();
            _sourceMetrics.clear();
            _sourceTextWidth = 0.0f;
            _selectedSourceLine = line;
            _scrollToSourceLine = true;
            _selectSourceTab = true;

            std::ifstream input(path);
            if (!input)
            {
                _sourceError = "Unable to open source file: " + path;
                return;
            }

            std::string text;
            while (std::getline(input, text))
            {
                if (!text.empty() && text.back() == '\r')
                    text.pop_back();
                _sourceTextWidth = (std::max)(
                    _sourceTextWidth,
                    ImGui::CalcTextSize(text.c_str()).x);
                _sourceLines.push_back(std::move(text));
            }
            rebuildSourceMetrics();
        }

        void clearDiagnosticStorage()
        {
            // Release snapshot/source scratch before measuring. Observed
            // activity rows intentionally survive captures so lifetime peaks
            // remain explorable even when inactive rows are temporarily hidden.
            _report = HeapHotspotReport();
            _liveSnapshot = HeapHotspotLiveSnapshot();
            std::string().swap(_sourcePath);
            std::string().swap(_sourceError);
            std::string().swap(_status);
            std::string().swap(_liveStatus);
            std::vector<std::string>().swap(_sourceLines);
            std::vector<HeapHotspotLineMetrics>().swap(_sourceMetrics);
            std::vector<SitePeakHistory>().swap(_pendingPeakHistory);
            std::vector<ActivityRow>().swap(_pendingActivityRows);
            std::vector<std::size_t>().swap(_visibleActivityRows);
            for (ActivityRow& row : _activityRows)
                row.siteIndex = static_cast<std::size_t>(-1);
            std::vector<ResolvedSiteIndex>().swap(_resolvedSiteIndices);
            _sourceTextWidth = 0.0f;
            _selectedSite = static_cast<std::size_t>(-1);
            _selectedRecommendation = static_cast<std::size_t>(-1);
            _selectedSourceLine = 0;
        }

        void rebuildActivityRows()
        {
            _pendingActivityRows.clear();
            _pendingActivityRows.reserve(_report.sites.size());
            for (std::size_t siteIndex = 0;
                 siteIndex < _report.sites.size();
                 ++siteIndex)
            {
                const std::uint64_t siteId = _report.sites[siteIndex].id;
                const auto history = std::lower_bound(
                    _sitePeakHistory.begin(),
                    _sitePeakHistory.end(),
                    siteId,
                    [](const SitePeakHistory& value, std::uint64_t id)
                    {
                        return value.siteId < id;
                    });
                if (history == _sitePeakHistory.end() || history->siteId != siteId)
                    continue;

                const HeapHotspotSite& site = _report.sites[siteIndex];
                ActivityRow row;
                row.siteId = site.id;
                row.currentBytes = site.liveBytes;
                row.currentAllocations = site.liveAllocations;
                row.topAddress = site.callStack.empty()
                    ? 0
                    : site.callStack.front().address;
                row.siteIndex = siteIndex;
                row.historyIndex = static_cast<std::size_t>(
                    history - _sitePeakHistory.begin());
                row.resolved = true;
                _pendingActivityRows.push_back(row);
            }

            publishActivityRows();
        }

        void publishActivityRows()
        {
            for (ActivityRow& row : _activityRows)
            {
                row.currentBytes = 0;
                row.currentAllocations = 0;
                row.siteIndex = resolvedSiteIndex(row.siteId);
                if (row.siteIndex < _report.sites.size())
                    row.resolved = true;
            }

            const auto bySiteId = [](const ActivityRow& lhs, const ActivityRow& rhs)
            {
                return lhs.siteId < rhs.siteId;
            };
            std::sort(_activityRows.begin(), _activityRows.end(), bySiteId);
            std::sort(
                _pendingActivityRows.begin(),
                _pendingActivityRows.end(),
                bySiteId);

            const std::size_t oldSize = _activityRows.size();
            _activityRows.insert(
                _activityRows.end(),
                _pendingActivityRows.begin(),
                _pendingActivityRows.end());
            std::inplace_merge(
                _activityRows.begin(),
                _activityRows.begin() + oldSize,
                _activityRows.end(),
                bySiteId);

            std::size_t writeIndex = 0;
            for (std::size_t readIndex = 0;
                 readIndex < _activityRows.size();
                 ++readIndex)
            {
                if (writeIndex > 0 &&
                    _activityRows[writeIndex - 1].siteId ==
                        _activityRows[readIndex].siteId)
                {
                    // Stable merge places the freshly sampled row after the
                    // retained inactive row, so it replaces the zero values.
                    _activityRows[writeIndex - 1] = _activityRows[readIndex];
                }
                else
                {
                    _activityRows[writeIndex++] = _activityRows[readIndex];
                }
            }
            _activityRows.resize(writeIndex);
            _pendingActivityRows.clear();

            // Peak history is sorted independently by ID, so refresh indices
            // after merging retained and active rows.
            for (ActivityRow& row : _activityRows)
            {
                const auto history = std::lower_bound(
                    _sitePeakHistory.begin(),
                    _sitePeakHistory.end(),
                    row.siteId,
                    [](const SitePeakHistory& value, std::uint64_t id)
                    {
                        return value.siteId < id;
                    });
                if (history != _sitePeakHistory.end() &&
                    history->siteId == row.siteId)
                {
                    row.historyIndex = static_cast<std::size_t>(
                        history - _sitePeakHistory.begin());
                }
            }
            sortActivityRows();
        }

        void sortActivityRows()
        {
            std::stable_sort(
                _activityRows.begin(),
                _activityRows.end(),
                [&](const ActivityRow& lhs, const ActivityRow& rhs)
                {
                    const SitePeakHistory& leftHistory =
                        _sitePeakHistory[lhs.historyIndex];
                    const SitePeakHistory& rightHistory =
                        _sitePeakHistory[rhs.historyIndex];
                    const std::uint64_t leftCurrent = _activityMetric == 0
                        ? lhs.currentBytes
                        : lhs.currentAllocations;
                    const std::uint64_t rightCurrent = _activityMetric == 0
                        ? rhs.currentBytes
                        : rhs.currentAllocations;
                    const std::uint64_t leftPeak = _activityMetric == 0
                        ? leftHistory.peakBytes
                        : leftHistory.peakAllocations;
                    const std::uint64_t rightPeak = _activityMetric == 0
                        ? rightHistory.peakBytes
                        : rightHistory.peakAllocations;
                    const std::uint64_t leftPeakEvents = _activityMetric == 0
                        ? leftHistory.bytesPeakEvents
                        : leftHistory.allocationsPeakEvents;
                    const std::uint64_t rightPeakEvents = _activityMetric == 0
                        ? rightHistory.bytesPeakEvents
                        : rightHistory.allocationsPeakEvents;

                    std::uint64_t leftValue = leftHistory.firstSeenOrder;
                    std::uint64_t rightValue = rightHistory.firstSeenOrder;
                    if (_activitySort == 1)
                    {
                        leftValue = leftCurrent;
                        rightValue = rightCurrent;
                    }
                    else if (_activitySort == 2)
                    {
                        leftValue = leftPeak;
                        rightValue = rightPeak;
                    }
                    else if (_activitySort == 3)
                    {
                        leftValue = leftPeakEvents;
                        rightValue = rightPeakEvents;
                    }

                    if (_activitySort == 4)
                    {
                        const HeapHotspotSite* leftSite =
                            lhs.siteIndex < _report.sites.size()
                                ? &_report.sites[lhs.siteIndex]
                                : nullptr;
                        const HeapHotspotSite* rightSite =
                            rhs.siteIndex < _report.sites.size()
                                ? &_report.sites[rhs.siteIndex]
                                : nullptr;
                        const std::string* leftName = leftSite
                            ? (!leftSite->function.empty()
                                ? &leftSite->function
                                : (!leftSite->file.empty()
                                    ? &leftSite->file
                                    : nullptr))
                            : nullptr;
                        const std::string* rightName = rightSite
                            ? (!rightSite->function.empty()
                                ? &rightSite->function
                                : (!rightSite->file.empty()
                                    ? &rightSite->file
                                    : nullptr))
                            : nullptr;

                        if (leftName && rightName && *leftName != *rightName)
                        {
                            return _activitySortDescending
                                ? *leftName > *rightName
                                : *leftName < *rightName;
                        }
                        if (leftName != nullptr && rightName == nullptr)
                            return true;
                        if (leftName == nullptr && rightName != nullptr)
                            return false;
                        if (lhs.topAddress != rhs.topAddress)
                        {
                            return _activitySortDescending
                                ? lhs.topAddress > rhs.topAddress
                                : lhs.topAddress < rhs.topAddress;
                        }
                    }
                    else if (leftValue != rightValue)
                    {
                        return _activitySortDescending
                            ? leftValue > rightValue
                            : leftValue < rightValue;
                    }

                    if (leftHistory.firstSeenOrder != rightHistory.firstSeenOrder)
                    {
                        return leftHistory.firstSeenOrder <
                            rightHistory.firstSeenOrder;
                    }
                    return lhs.siteId < rhs.siteId;
                });
        }

        void rebuildResolvedSiteIndices()
        {
            _resolvedSiteIndices.clear();
            _resolvedSiteIndices.reserve(_report.sites.size());
            for (std::size_t siteIndex = 0;
                 siteIndex < _report.sites.size();
                 ++siteIndex)
            {
                _resolvedSiteIndices.push_back({
                    _report.sites[siteIndex].id, siteIndex });
            }
            std::sort(
                _resolvedSiteIndices.begin(),
                _resolvedSiteIndices.end(),
                [](const ResolvedSiteIndex& lhs, const ResolvedSiteIndex& rhs)
                {
                    return lhs.siteId < rhs.siteId;
                });
        }

        std::size_t resolvedSiteIndex(std::uint64_t siteId) const
        {
            const auto found = std::lower_bound(
                _resolvedSiteIndices.begin(),
                _resolvedSiteIndices.end(),
                siteId,
                [](const ResolvedSiteIndex& value, std::uint64_t id)
                {
                    return value.siteId < id;
                });
            return found != _resolvedSiteIndices.end() && found->siteId == siteId
                ? found->siteIndex
                : static_cast<std::size_t>(-1);
        }

        void updateActivityHistory(bool flashNewPeaks)
        {
            const double now = ImGui::GetTime();
            std::vector<std::uint64_t> resolvedRawStackIds;
            _pendingPeakHistory.clear();
            for (const HeapHotspotSite& site : _report.sites)
            {
                const auto position = std::lower_bound(
                    _sitePeakHistory.begin(),
                    _sitePeakHistory.end(),
                    site.id,
                    [](const SitePeakHistory& value, std::uint64_t id)
                    {
                        return value.siteId < id;
                    });

                if (position == _sitePeakHistory.end() || position->siteId != site.id)
                {
                    SitePeakHistory value;
                    value.siteId = site.id;
                    value.firstSeenOrder = _nextActivityOrder++;
                    _pendingPeakHistory.push_back(value);
                }
            }

            if (!_pendingPeakHistory.empty())
            {
                std::sort(
                    _pendingPeakHistory.begin(),
                    _pendingPeakHistory.end(),
                    [](const SitePeakHistory& lhs, const SitePeakHistory& rhs)
                    {
                        return lhs.siteId < rhs.siteId;
                    });
                _pendingPeakHistory.erase(
                    std::unique(
                        _pendingPeakHistory.begin(),
                        _pendingPeakHistory.end(),
                        [](const SitePeakHistory& lhs, const SitePeakHistory& rhs)
                        {
                            return lhs.siteId == rhs.siteId;
                        }),
                    _pendingPeakHistory.end());
                _sitePeakHistory.insert(
                    _sitePeakHistory.end(),
                    _pendingPeakHistory.begin(),
                    _pendingPeakHistory.end());
                std::sort(
                    _sitePeakHistory.begin(),
                    _sitePeakHistory.end(),
                    [](const SitePeakHistory& lhs, const SitePeakHistory& rhs)
                    {
                        return lhs.siteId < rhs.siteId;
                    });
            }

            for (const HeapHotspotSite& site : _report.sites)
            {
                const auto position = std::lower_bound(
                    _sitePeakHistory.begin(),
                    _sitePeakHistory.end(),
                    site.id,
                    [](const SitePeakHistory& value, std::uint64_t id)
                    {
                        return value.siteId < id;
                    });
                if (position == _sitePeakHistory.end() || position->siteId != site.id)
                    continue;

                SitePeakHistory* history = &*position;
                // A full capture changes a row from its raw stack ID to a
                // resolved source-site ID. Carry the observations forward so
                // resolving symbols never looks like a peak reset.
                std::uint64_t inheritedBytesPeakEvents = 0;
                std::uint64_t inheritedAllocationsPeakEvents = 0;
                for (std::uint64_t rawStackId : site.allocationStackIds)
                {
                    if (rawStackId != site.id)
                        resolvedRawStackIds.push_back(rawStackId);
                    if (_selectedActivitySiteId == rawStackId)
                        _selectedActivitySiteId = site.id;

                    const auto rawPosition = std::lower_bound(
                        _sitePeakHistory.begin(),
                        _sitePeakHistory.end(),
                        rawStackId,
                        [](const SitePeakHistory& value, std::uint64_t id)
                        {
                            return value.siteId < id;
                        });
                    if (rawPosition == _sitePeakHistory.end() ||
                        rawPosition->siteId != rawStackId)
                    {
                        continue;
                    }

                    history->firstSeenOrder = (std::min)(
                        history->firstSeenOrder,
                        rawPosition->firstSeenOrder);
                    if (rawPosition->peakBytes > history->peakBytes)
                    {
                        history->peakBytes = rawPosition->peakBytes;
                        history->bytesPeakTime = rawPosition->bytesPeakTime;
                    }
                    if (rawPosition->peakAllocations > history->peakAllocations)
                    {
                        history->peakAllocations = rawPosition->peakAllocations;
                        history->allocationsPeakTime =
                            rawPosition->allocationsPeakTime;
                    }
                    inheritedBytesPeakEvents +=
                        rawPosition->bytesPeakEvents;
                    inheritedAllocationsPeakEvents +=
                        rawPosition->allocationsPeakEvents;
                }
                history->bytesPeakEvents = (std::max)(
                    history->bytesPeakEvents,
                    inheritedBytesPeakEvents);
                history->allocationsPeakEvents = (std::max)(
                    history->allocationsPeakEvents,
                    inheritedAllocationsPeakEvents);

                if (site.liveBytes > history->peakBytes)
                {
                    history->peakBytes = site.liveBytes;
                    ++history->bytesPeakEvents;
                    history->bytesPeakTime = flashNewPeaks ? now : -1000.0;
                }
                if (site.liveAllocations > history->peakAllocations)
                {
                    history->peakAllocations = site.liveAllocations;
                    ++history->allocationsPeakEvents;
                    history->allocationsPeakTime = flashNewPeaks ? now : -1000.0;
                }
            }

            if (!resolvedRawStackIds.empty())
            {
                std::sort(
                    resolvedRawStackIds.begin(), resolvedRawStackIds.end());
                resolvedRawStackIds.erase(
                    std::unique(
                        resolvedRawStackIds.begin(), resolvedRawStackIds.end()),
                    resolvedRawStackIds.end());
                _activityRows.erase(
                    std::remove_if(
                        _activityRows.begin(),
                        _activityRows.end(),
                        [&](const ActivityRow& row)
                        {
                            return std::binary_search(
                                resolvedRawStackIds.begin(),
                                resolvedRawStackIds.end(),
                                row.siteId);
                        }),
                    _activityRows.end());
            }
            _pendingPeakHistory.clear();
            rebuildActivityRows();
        }

        void resetActivityPeaks()
        {
            _pendingPeakHistory.clear();
            _pendingPeakHistory.reserve(_activityRows.size());
            for (const ActivityRow& row : _activityRows)
            {
                SitePeakHistory history;
                history.siteId = row.siteId;
                history.peakBytes = row.currentBytes;
                history.peakAllocations = row.currentAllocations;
                history.firstSeenOrder =
                    _sitePeakHistory[row.historyIndex].firstSeenOrder;
                _pendingPeakHistory.push_back(history);
            }
            std::sort(
                _pendingPeakHistory.begin(),
                _pendingPeakHistory.end(),
                [](const SitePeakHistory& lhs, const SitePeakHistory& rhs)
                {
                    return lhs.siteId < rhs.siteId;
                });
            _sitePeakHistory.swap(_pendingPeakHistory);
            _pendingPeakHistory.clear();

            for (ActivityRow& row : _activityRows)
            {
                const auto history = std::lower_bound(
                    _sitePeakHistory.begin(),
                    _sitePeakHistory.end(),
                    row.siteId,
                    [](const SitePeakHistory& value, std::uint64_t id)
                    {
                        return value.siteId < id;
                    });
                if (history != _sitePeakHistory.end() && history->siteId == row.siteId)
                {
                    row.historyIndex = static_cast<std::size_t>(
                        history - _sitePeakHistory.begin());
                }
            }
            sortActivityRows();
        }

        void updateLiveActivity()
        {
            if (!_liveCapture || _liveSamplingPaused)
                return;

            const double now = ImGui::GetTime();
            if (now < _nextLiveSampleTime)
                return;
            _nextLiveSampleTime = now + static_cast<double>(_liveSampleInterval);

            _liveSnapshot = _liveCapture();
            if (!_liveSnapshot.valid)
            {
                _liveStatus = _liveSnapshot.error;
                return;
            }
            _liveStatus.clear();

            _pendingPeakHistory.clear();
            for (const HeapHotspotLiveSite& site : _liveSnapshot.sites)
            {
                const auto history = std::lower_bound(
                    _sitePeakHistory.begin(),
                    _sitePeakHistory.end(),
                    site.id,
                    [](const SitePeakHistory& value, std::uint64_t id)
                    {
                        return value.siteId < id;
                    });
                if (history == _sitePeakHistory.end() || history->siteId != site.id)
                {
                    SitePeakHistory value;
                    value.siteId = site.id;
                    value.firstSeenOrder = _nextActivityOrder++;
                    _pendingPeakHistory.push_back(value);
                }
            }
            if (!_pendingPeakHistory.empty())
            {
                std::sort(
                    _pendingPeakHistory.begin(),
                    _pendingPeakHistory.end(),
                    [](const SitePeakHistory& lhs, const SitePeakHistory& rhs)
                    {
                        return lhs.siteId < rhs.siteId;
                    });
                _pendingPeakHistory.erase(
                    std::unique(
                        _pendingPeakHistory.begin(),
                        _pendingPeakHistory.end(),
                        [](const SitePeakHistory& lhs, const SitePeakHistory& rhs)
                        {
                            return lhs.siteId == rhs.siteId;
                        }),
                    _pendingPeakHistory.end());
                _sitePeakHistory.insert(
                    _sitePeakHistory.end(),
                    _pendingPeakHistory.begin(),
                    _pendingPeakHistory.end());
                std::sort(
                    _sitePeakHistory.begin(),
                    _sitePeakHistory.end(),
                    [](const SitePeakHistory& lhs, const SitePeakHistory& rhs)
                    {
                        return lhs.siteId < rhs.siteId;
                    });
            }

            _pendingActivityRows.clear();
            _pendingActivityRows.reserve(_liveSnapshot.sites.size());
            for (const HeapHotspotLiveSite& site : _liveSnapshot.sites)
            {
                const auto historyPosition = std::lower_bound(
                    _sitePeakHistory.begin(),
                    _sitePeakHistory.end(),
                    site.id,
                    [](const SitePeakHistory& value, std::uint64_t id)
                    {
                        return value.siteId < id;
                    });
                if (historyPosition == _sitePeakHistory.end() ||
                    historyPosition->siteId != site.id)
                {
                    continue;
                }

                SitePeakHistory& history = *historyPosition;
                if (site.liveBytes > history.peakBytes)
                {
                    history.peakBytes = site.liveBytes;
                    ++history.bytesPeakEvents;
                    history.bytesPeakTime = now;
                }
                if (site.liveAllocations > history.peakAllocations)
                {
                    history.peakAllocations = site.liveAllocations;
                    ++history.allocationsPeakEvents;
                    history.allocationsPeakTime = now;
                }

                ActivityRow row;
                row.siteId = site.id;
                row.currentBytes = site.liveBytes;
                row.currentAllocations = site.liveAllocations;
                row.topAddress = site.topAddress;
                row.siteIndex = resolvedSiteIndex(site.id);
                row.historyIndex = static_cast<std::size_t>(
                    historyPosition - _sitePeakHistory.begin());
                row.resolved = site.resolved;
                _pendingActivityRows.push_back(row);
            }
            _pendingPeakHistory.clear();
            publishActivityRows();
        }

