        bool activityRowIsVisible(const ActivityRow& row) const
        {
            if (row.historyIndex >= _sitePeakHistory.size())
                return false;
            if (!_showInactiveActivitySites && row.currentAllocations == 0)
                return false;

            const SitePeakHistory& history =
                _sitePeakHistory[row.historyIndex];
            if (_activityMetric == 0)
            {
                return toMiB(row.currentBytes) >= _minimumActiveMiB &&
                    toMiB(history.peakBytes) >= _minimumPeakMiB;
            }
            return row.currentAllocations >= static_cast<std::uint64_t>(
                    _minimumActiveAllocations) &&
                history.peakAllocations >= static_cast<std::uint64_t>(
                    _minimumPeakAllocations);
        }

        void drawActivityBar(
            const ActivityRow& row,
            const HeapHotspotSite* site,
            const SitePeakHistory& history,
            std::uint64_t scaleMaximum,
            std::size_t rowIndex)
        {
            const std::uint64_t current = _activityMetric == 0
                ? row.currentBytes
                : row.currentAllocations;
            const std::uint64_t peak = _activityMetric == 0
                ? history.peakBytes
                : history.peakAllocations;
            const double peakTime = _activityMetric == 0
                ? history.bytesPeakTime
                : history.allocationsPeakTime;

            const float width = (std::max)(1.0f, ImGui::GetContentRegionAvail().x);
            const float height = (std::max)(12.0f, ImGui::GetFrameHeight() - 3.0f);
            ImGui::PushID(static_cast<int>(rowIndex));
            const bool clicked = ImGui::InvisibleButton(
                "allocation activity bar", ImVec2(width, height));
            const bool hovered = ImGui::IsItemHovered();
            const ImVec2 minimum = ImGui::GetItemRectMin();
            const ImVec2 maximum = ImGui::GetItemRectMax();
            ImGui::PopID();

            const double denominator = static_cast<double>(
                scaleMaximum > 0 ? scaleMaximum : 1);
            const float currentFraction = static_cast<float>(
                static_cast<double>(current) / denominator);
            const float peakFraction = static_cast<float>(
                static_cast<double>(peak) / denominator);
            const float currentX = minimum.x + width * currentFraction;
            const float peakX = minimum.x + width * peakFraction;

            const ImVec4 currentColor = _activityMetric == 0
                ? ImVec4(0.20f, 0.55f, 0.95f, 0.90f)
                : ImVec4(0.20f, 0.76f, 0.50f, 0.90f);
            const ImVec4 ghostColor = _activityMetric == 0
                ? ImVec4(0.20f, 0.55f, 0.95f, 0.18f)
                : ImVec4(0.20f, 0.76f, 0.50f, 0.18f);
            ImDrawList* drawList = ImGui::GetWindowDrawList();
            drawList->AddRectFilled(
                minimum, maximum, ImGui::GetColorU32(ImVec4(0.08f, 0.10f, 0.14f, 0.72f)), 3.0f);
            if (peak > 0)
            {
                drawList->AddRectFilled(
                    minimum,
                    ImVec2(peakX, maximum.y),
                    ImGui::GetColorU32(ghostColor),
                    3.0f);
            }
            if (current > 0)
            {
                drawList->AddRectFilled(
                    minimum,
                    ImVec2(currentX, maximum.y),
                    ImGui::GetColorU32(currentColor),
                    3.0f);
            }
            if (peak > 0)
            {
                drawList->AddLine(
                    ImVec2(peakX, minimum.y - 1.0f),
                    ImVec2(peakX, maximum.y + 1.0f),
                    ImGui::GetColorU32(ImVec4(0.78f, 0.84f, 0.94f, 0.82f)),
                    2.0f);
            }

            constexpr double flashDuration = 1.25;
            const double peakAge = ImGui::GetTime() - peakTime;
            if (peakAge >= 0.0 && peakAge < flashDuration)
            {
                const float intensity = static_cast<float>(
                    1.0 - peakAge / flashDuration);
                drawList->AddRect(
                    minimum,
                    maximum,
                    ImGui::GetColorU32(
                        ImVec4(1.0f, 0.72f, 0.18f, 0.30f + intensity * 0.70f)),
                    3.0f,
                    0,
                    1.0f + intensity * 2.0f);
            }

            if (hovered)
            {
                ImGui::SetTooltip(
                    "%s\nCurrent: %s\nPeak: %s\nObserved new peaks: %llu",
                    site && !site->function.empty()
                        ? site->function.c_str()
                        : (row.resolved ? "Resolved site" : "Unresolved stack"),
                    formatActivityValue(current).c_str(),
                    formatActivityValue(peak).c_str(),
                    static_cast<unsigned long long>(
                        _activityMetric == 0
                            ? history.bytesPeakEvents
                            : history.allocationsPeakEvents));
            }
            if (clicked)
                _selectedActivitySiteId = row.siteId;
        }

