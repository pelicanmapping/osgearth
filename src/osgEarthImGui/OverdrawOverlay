#include <osg/BlendEquation>
#include <osg/BlendFunc>
#include <osg/Geometry>
#include <osg/Multisample>
#include <osg/PolygonMode>
#include <osg/Program>
#include <osg/Texture2D>
#include <osgUtil/CullVisitor>
#include <algorithm>
#include <atomic>
#include <limits>
#include <map>
