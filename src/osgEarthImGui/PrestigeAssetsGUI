        }

        //-------------------------------------------------------------------
        // math / path helpers

        static double clampBetween(double v, double lo, double hi)
        {
            return v < lo ? lo : v > hi ? hi : v;
        }

        static double normalizeDegrees(double deg)
        {
            while (deg > 180.0) deg -= 360.0;
            while (deg < -180.0) deg += 360.0;
            return deg;
        }

        static bool startsWithNoCase(const std::string& s, const std::string& prefix)
        {
            if (s.size() < prefix.size()) return false;
            for (size_t i = 0; i < prefix.size(); ++i)
                if (::tolower((unsigned char)s[i]) != ::tolower((unsigned char)prefix[i]))
                    return false;
            return true;
        }

        // The Prestige convention keeps asset_points.geojson in <root>/assets/,
        // with asset_path values relative to <root>.
        static std::string defaultProjectRoot(const std::string& geojsonPath)
        {
            std::string dir = osgDB::convertFileNameToUnixStyle(osgDB::getFilePath(geojsonPath));
            if (ciEquals(osgDB::getSimpleFileName(dir), "assets"))
                return osgDB::getFilePath(dir);
            return dir;
        }

        std::string resolveAssetPath(const std::string& assetPath) const
        {
            std::string p = osgDB::convertFileNameToUnixStyle(assetPath);
            if (!osgDB::isAbsolutePath(p) && !_projectRoot.empty())
                p = osgDB::concatPaths(_projectRoot, p);
            return p;
        }

        std::string toStoredPath(const std::string& absPath) const
        {
            std::string abs = osgDB::convertFileNameToUnixStyle(absPath);
            if (!_projectRoot.empty())
            {
                std::string root = osgDB::convertFileNameToUnixStyle(_projectRoot);
                if (!root.empty() && root[root.size() - 1] != '/')
                    root += "/";
                if (startsWithNoCase(abs, root))
                    return abs.substr(root.size());
            }
            return abs;
        }

        static bool isModelFile(const std::string& path)
        {
            static const std::set<std::string> exts = {
                "glb", "gltf", "obj", "osgb", "osgt", "osg", "ive", "fbx", "dae", "3ds", "lwo", "flt"
            };
            return exts.count(osgDB::getLowerCaseFileExtension(path)) > 0;
        }

        std::string uniqueName(const std::string& base) const
        {
            std::set<std::string> names;
            for (const auto& a : _assets)
                names.insert(a.name);
            if (names.count(base) == 0)
                return base;
            for (int i = 1; ; ++i)
            {
                std::string candidate = base + "_" + std::to_string(i);
                if (names.count(candidate) == 0)
                    return candidate;
            }
        }

        //-------------------------------------------------------------------
        // JSON I/O

        static double numberOr(const Json::Value& v, double fallback)
        {
            if (v.isNumeric()) return v.asDouble();
            if (v.isString())
            {
                const std::string s = v.asString();
                char* end = nullptr;
                double d = strtod(s.c_str(), &end);
                if (end && end != s.c_str()) return d;
            }
            return fallback;
        }

    public:
        //! Loads a Prestige asset_points geojson file into the editor.
        bool loadFile(const std::string& inPath)
        {
            std::string path = Strings::trim(inPath);
            if (path.empty())
            {
                setStatus("Enter a geojson file path first.");
                return false;
            }

            std::ifstream in(path.c_str(), std::ios::binary);
            if (!in)
            {
                setStatus("Failed to open: " + path);
                return false;
            }
            std::stringstream buffer;
            buffer << in.rdbuf();

            Json::Reader reader;
            Json::Value doc;
            if (!reader.parse(buffer.str(), doc) || !doc.isObject())
            {
                setStatus("Not valid JSON: " + path);
                return false;
            }

            clearAssets();

            _filePath = path;
            _projectRoot = defaultProjectRoot(path);
            _pathInput = path;
            _projectRootInput = _projectRoot;

            _docExtras = Json::Value(Json::objectValue);
            for (const auto& member : doc.getMemberNames())
            {
                if (member != "type" && member != "features")
                    _docExtras[member] = doc[member];
            }

            const Json::Value& features = doc["features"];
            if (features.isArray())
            {
                for (Json::Value::ArrayIndex i = 0; i < features.size(); ++i)
                {
                    const Json::Value& f = features[i];
                    const Json::Value& geom = f["geometry"];

                    bool isPoint =
                        geom.isObject() &&
                        geom["type"].isString() && geom["type"].asString() == "Point" &&
                        geom["coordinates"].isArray() && geom["coordinates"].size() >= 2;

                    if (!isPoint)
                    {
                        // preserved and re-written verbatim on save.
                        _foreignFeatures.push_back(f);
                        continue;
                    }

                    Asset a;
                    a.lon = numberOr(geom["coordinates"][0u], 0.0);
                    a.lat = numberOr(geom["coordinates"][1u], 0.0);

                    const Json::Value& props = f["properties"];
                    if (props.isObject())
                    {
                        if (props["name"].isString()) a.name = props["name"].asString();
                        if (props["asset_path"].isString()) a.assetPath = props["asset_path"].asString();
                        if (props.isMember("rotation")) a.rotation = numberOr(props["rotation"], 0.0);
                        if (props.isMember("scale")) a.scale = numberOr(props["scale"], 1.0);
                        if (props.isMember("elevation"))
                        {
                            a.elevation = numberOr(props["elevation"], 0.0);
                            a.writeElevation = true;
                        }
                        if (props.isMember("elevation_mode"))
                        {
                            a.absolute = props["elevation_mode"].isString() &&
                                props["elevation_mode"].asString() == "absolute";
                            a.writeElevationMode = true;
                        }

                        for (const auto& key : props.getMemberNames())
                        {
                            if (key != "name" && key != "asset_path" && key != "rotation" &&
                                key != "scale" && key != "elevation" && key != "elevation_mode")
                            {
                                a.extraProps[key] = props[key];
                            }
                        }
                    }

                    if (a.name.empty())
                    {
                        char buf[32];
                        snprintf(buf, sizeof(buf), "Asset_%05d", (int)i);
                        a.name = buf;
                    }

                    _assets.push_back(a);
                }
            }

            for (auto& a : _assets)
                buildAssetNode(a);

            _selected = -1;
            _dirty = false;
            setStatus("Loaded " + std::to_string(_assets.size()) + " asset(s) from " + path);
            return true;
        }

    private:
        // shortest numeric representation that round-trips exactly, preferring
        // plain decimal notation, with a trailing ".0" so whole numbers still
        // read as doubles (matches the original file's style).
        static std::string jsonNumber(double v)
        {
            if (v != v) return "0.0"; // NaN guard
            char buf[400] = { 0 };
            std::string best;
            for (int prec = 1; prec <= 17; ++prec)
            {
                snprintf(buf, sizeof(buf), "%.*g", prec, v);
                if (strtod(buf, nullptr) == v)
                {
                    best = buf;
                    break;
                }
            }
            if (best.empty())
                best = "0.0";

            // %g may pick exponent form (9e+01); prefer a plain decimal form
            // when one of similar length also round-trips.
            if (best.find_first_of("eE") != std::string::npos)
            {
                for (int dec = 0; dec <= 17; ++dec)
                {
                    snprintf(buf, sizeof(buf), "%.*f", dec, v);
                    if (strtod(buf, nullptr) == v)
                    {
                        std::string plain(buf);
                        if (plain.size() <= best.size() + 6)
                            best = plain;
                        break;
                    }
                }
            }

            if (best.find_first_of(".eE") == std::string::npos)
                best += ".0";
            return best;
        }

        static std::string compactJson(const Json::Value& v)
        {
            Json::FastWriter writer;
            std::string s = writer.write(v);
            while (!s.empty() && (s[s.size() - 1] == '\n' || s[s.size() - 1] == '\r' || s[s.size() - 1] == ' '))
                s.erase(s.size() - 1);
            return s;
        }

        void writeFeature(std::ostream& out, const Asset& a) const
        {
            out << "    {\n";
            out << "      \"type\": \"Feature\",\n";
            out << "      \"properties\": {\n";

            std::vector<std::string> lines;
            lines.push_back(std::string("\"name\": ") + Json::valueToQuotedString(a.name.c_str()));
            lines.push_back(std::string("\"asset_path\": ") + Json::valueToQuotedString(a.assetPath.c_str()));
            lines.push_back(std::string("\"rotation\": ") + jsonNumber(a.rotation));
            lines.push_back(std::string("\"scale\": ") + jsonNumber(a.scale));
            if (a.writeElevationMode || a.absolute)
                lines.push_back(std::string("\"elevation_mode\": \"") + (a.absolute ? "absolute" : "relative") + "\"");
            if (a.writeElevation || a.elevation != 0.0)
                lines.push_back(std::string("\"elevation\": ") + jsonNumber(a.elevation));
            for (const auto& key : a.extraProps.getMemberNames())
                lines.push_back(std::string(Json::valueToQuotedString(key.c_str())) + ": " + compactJson(a.extraProps[key]));

            for (size_t i = 0; i < lines.size(); ++i)
                out << "        " << lines[i] << (i + 1 < lines.size() ? "," : "") << "\n";

            out << "      },\n";
            out << "      \"geometry\": {\n";
            out << "        \"type\": \"Point\",\n";
            out << "        \"coordinates\": [\n";
            out << "          " << jsonNumber(a.lon) << ",\n";
            out << "          " << jsonNumber(a.lat) << "\n";
            out << "        ]\n";
            out << "      }\n";
            out << "    }";
        }

    public:
        //! Writes the current assets to a geojson file in the Prestige format.
        bool saveFile(const std::string& inPath)
        {
            std::string path = Strings::trim(inPath);
            if (path.empty())
            {
                setStatus("Enter a file path to save to.");
                return false;
            }

            std::ostringstream out;
            out << "{\n";
            out << "  \"type\": \"FeatureCollection\",\n";

            for (const auto& member : _docExtras.getMemberNames())
                out << "  " << Json::valueToQuotedString(member.c_str()) << ": " << compactJson(_docExtras[member]) << ",\n";

            out << "  \"features\": [\n";

            bool first = true;
            for (const auto& a : _assets)
            {
                if (!first) out << ",\n";
                writeFeature(out, a);
                first = false;
            }
            for (const auto& f : _foreignFeatures)
            {
                if (!first) out << ",\n";
                out << "    " << compactJson(f);
                first = false;
            }
            if (!first) out << "\n";

            out << "  ]\n";
            out << "}\n";

            std::ofstream file(path.c_str(), std::ios::binary | std::ios::trunc);
            if (!file)
            {
                setStatus("Failed to write: " + path);
                return false;
            }
            file << out.str();
            file.close();

            _filePath = path;
            _dirty = false;
            setStatus("Saved " + std::to_string(_assets.size()) + " asset(s) to " + path);
            return true;
        }

    private:
        //-------------------------------------------------------------------
        // scene management

        void clearAssets()
        {
            if (_root.valid())
                _root->removeChildren(0, _root->getNumChildren());
            _assets.clear();
            _foreignFeatures.clear();
            _docExtras = Json::Value(Json::objectValue);
            _selected = -1;
            _dragAsset = -1;
            _dragMode = DRAG_NONE;
        }

        // Model files can be hundreds of MB each and decode multi-GB texture
        // buffers transiently; a narrow dedicated pool keeps the peak memory
        // (and disk churn) bounded while still loading in the background.
        static jobs::context& loadContext()
        {
            static jobs::context s = []()
                {
                    jobs::context c;
                    auto* pool = jobs::get_pool("oe.prestige_assets");
                    pool->set_concurrency(2);
                    c.pool = pool;
                    return c;
                }();
            return s;
        }

        ModelEntry* getOrLoadModel(const std::string& absPath)
        {
            auto it = _models.find(absPath);
            if (it != _models.end())
                return it->second.get();

            osg::ref_ptr<ModelEntry> entry = new ModelEntry();
            entry->absPath = absPath;

            if (!osgDB::fileExists(absPath))
            {
                entry->pending = false;
                entry->failed = true;
                OE_WARN << "[PrestigeAssets] Model file not found: " << absPath << std::endl;
            }
            else
            {
                entry->future = jobs::dispatch([absPath](Cancelable& c)
                    {
                        // GLB loads decode large texture buffers; anything thrown
                        // here (e.g. bad_alloc) must not escape the job thread.
                        // NOTE: shader generation runs on the main thread when the
                        // model is attached - it is not safe to run concurrently.
                        osg::ref_ptr<osg::Node> node;
                        try
                        {
                            node = osgDB::readRefNodeFile(absPath);
                        }
                        catch (const std::exception& e)
                        {
                            OE_WARN << "[PrestigeAssets] Exception loading " << absPath << ": " << e.what() << std::endl;
                            node = nullptr;
                        }
                        catch (...)
                        {
                            OE_WARN << "[PrestigeAssets] Unknown exception loading " << absPath << std::endl;
                            node = nullptr;
                        }
                        return node;
                    },
                    loadContext());
            }

            _models[absPath] = entry;
            return entry.get();
        }

        void buildAssetNode(Asset& a)
        {
            a.xform = new GeoTransform();
            a.xform->setName(a.name);
            if (_mapNode.valid())
                a.xform->setTerrain(_mapNode->getTerrain());

            a.local = new osg::MatrixTransform();
            a.xform->addChild(a.local);

            a.model = getOrLoadModel(resolveAssetPath(a.assetPath));
            a.attached = false;

            if (_root.valid())
                _root->addChild(a.xform);

            applyPosition(a);
            applyLocalMatrix(a);
        }

        void reresolveModels()
        {
            for (auto& a : _assets)
            {
                a.model = getOrLoadModel(resolveAssetPath(a.assetPath));
                a.attached = false;
                if (a.local.valid())
                    a.local->removeChildren(0, a.local->getNumChildren());
                a.selectionNode = nullptr;
            }
        }

        void updateModels()
        {
            for (auto& kv : _models)
            {
                ModelEntry* e = kv.second.get();
                if (e->pending && e->future.available())
                {
                    e->node = e->future.value();
                    if (e->node.valid())
                    {
                        // main thread: safe to run the (stateful) shader generator.
                        Registry::shaderGenerator().run(e->node.get());

                        osg::ComputeBoundsVisitor cbv;
                        e->node->accept(cbv);
                        e->bbox = cbv.getBoundingBox();
                        if (!e->bbox.valid())
                            e->failed = true;
                    }
                    else
                    {
                        e->failed = true;
                        OE_WARN << "[PrestigeAssets] Failed to load model: " << e->absPath << std::endl;
                    }
                    e->pending = false;
                }
            }

            for (auto& a : _assets)
            {
                if (!a.attached && a.model.valid() && !a.model->pending)
                    attachModel(a);
            }
        }

        osg::BoundingBox assetBBox(const Asset& a) const
        {
            if (a.model.valid() && !a.model->pending && !a.model->failed && a.model->bbox.valid())
                return a.model->bbox;
            // placeholder box bounds:
            return osg::BoundingBox(-5.0f, -5.0f, 0.0f, 5.0f, 5.0f, 10.0f);
        }

        void attachModel(Asset& a)
        {
            if (!a.local.valid()) return;

            a.local->removeChildren(0, a.local->getNumChildren());

            if (a.model.valid() && a.model->node.valid() && !a.model->failed)
                a.local->addChild(a.model->node.get());
            else
                a.local->addChild(makeMissingPlaceholder());

            a.selectionNode = makeSelectionBox(assetBBox(a));
            a.local->addChild(a.selectionNode.get());

            buildGizmo(a);

            a.attached = true;
            applyLocalMatrix(a);
            refreshSelectionGraphics();
        }

        static osg::Node* makeMissingPlaceholder()
        {
            osg::ShapeDrawable* sd = new osg::ShapeDrawable(
                new osg::Box(osg::Vec3(0.0f, 0.0f, 5.0f), 10.0f, 10.0f, 10.0f));
            sd->setColor(osg::Vec4(1.0f, 0.25f, 0.25f, 1.0f));
            osg::Geode* geode = new osg::Geode();
            geode->addDrawable(sd);
            Registry::shaderGenerator().run(geode);
            return geode;
        }

        // unit-length +Z arrow (shaft + cone tip), shared per axis color.
        static osg::Node* sharedArrow(int axis)
        {
            static osg::ref_ptr<osg::Node> s_arrows[3];
            if (!s_arrows[axis].valid())
            {
                static const osg::Vec4 colors[3] = {
                    osg::Vec4(0.95f, 0.2f, 0.2f, 1.0f),   // east - red
                    osg::Vec4(0.2f, 0.85f, 0.2f, 1.0f),   // north - green
                    osg::Vec4(0.25f, 0.5f, 1.0f, 1.0f) }; // up - blue

                osg::ShapeDrawable* shaft = new osg::ShapeDrawable(
                    new osg::Cylinder(osg::Vec3(0.0f, 0.0f, 0.4f), 0.02f, 0.8f));
                shaft->setColor(colors[axis]);
                osg::ShapeDrawable* tip = new osg::ShapeDrawable(
                    new osg::Cone(osg::Vec3(0.0f, 0.0f, 0.85f), 0.06f, 0.3f));
                tip->setColor(colors[axis]);

                osg::Geode* geode = new osg::Geode();
                geode->addDrawable(shaft);
                geode->addDrawable(tip);
                Registry::shaderGenerator().run(geode);
                s_arrows[axis] = geode;
            }
            return s_arrows[axis].get();
        }

        // unit-radius flat annulus in the XY plane (heading rotation ring).
        static osg::Node* sharedRing()
        {
            static osg::ref_ptr<osg::Node> s_ring;
            if (!s_ring.valid())
            {
                const int segments = 48;
                const float outer = 1.0f, inner = 0.8f, z = 0.02f;

                osg::Vec3Array* verts = new osg::Vec3Array();
                verts->reserve((segments + 1) * 2);
                for (int i = 0; i <= segments; ++i)
                {
                    float angle = (float)(2.0 * osg::PI * (double)i / (double)segments);
                    float c = cosf(angle), s = sinf(angle);
                    verts->push_back(osg::Vec3(c * outer, s * outer, z));
                    verts->push_back(osg::Vec3(c * inner, s * inner, z));
                }

                osg::Geometry* geom = new osg::Geometry();
                geom->setVertexArray(verts);
                osg::Vec3Array* normals = new osg::Vec3Array();
                normals->push_back(osg::Vec3(0, 0, 1));
                geom->setNormalArray(normals, osg::Array::BIND_OVERALL);
                osg::Vec4Array* colors = new osg::Vec4Array();
                colors->push_back(osg::Vec4(1.0f, 0.55f, 0.1f, 1.0f)); // orange
                geom->setColorArray(colors, osg::Array::BIND_OVERALL);
                geom->addPrimitiveSet(new osg::DrawArrays(GL_TRIANGLE_STRIP, 0, (GLsizei)verts->size()));

                osg::Geode* geode = new osg::Geode();
                geode->addDrawable(geom);
                Registry::shaderGenerator().run(geode);
                s_ring = geode;
            }
            return s_ring.get();
        }

        // unit-length diagonal stalk with a cube tip (uniform scale handle).
        static osg::Node* sharedScaleHandle()
        {
            static osg::ref_ptr<osg::Node> s_handle;
            if (!s_handle.valid())
            {
                const osg::Vec4 color(0.75f, 0.3f, 0.95f, 1.0f); // purple
                osg::ShapeDrawable* stalk = new osg::ShapeDrawable(
                    new osg::Cylinder(osg::Vec3(0.0f, 0.0f, 0.44f), 0.015f, 0.88f));
                stalk->setColor(color);
                osg::ShapeDrawable* cube = new osg::ShapeDrawable(
                    new osg::Box(osg::Vec3(0.0f, 0.0f, 0.94f), 0.12f));
                cube->setColor(color);

                osg::Geode* geode = new osg::Geode();
                geode->addDrawable(stalk);
                geode->addDrawable(cube);
                Registry::shaderGenerator().run(geode);
                s_handle = geode;
            }
            return s_handle.get();
        }

        void buildGizmo(Asset& a)
        {
            if (a.gizmoNode.valid() || !a.xform.valid())
                return;
            a.gizmoNode = new osg::Group();
            for (int k = 0; k < 3; ++k)
            {
                a.axisNode[k] = new osg::MatrixTransform();
                a.axisNode[k]->addChild(sharedArrow(k));
                a.gizmoNode->addChild(a.axisNode[k].get());
            }
            a.ringNode = new osg::MatrixTransform();
            a.ringNode->addChild(sharedRing());
            a.gizmoNode->addChild(a.ringNode.get());

            a.scaleNode = new osg::MatrixTransform();
            a.scaleNode->addChild(sharedScaleHandle());
            a.gizmoNode->addChild(a.scaleNode.get());

            a.gizmoNode->setNodeMask(0); // off until selected
            // sibling of the model transform so the widgets stay ENU-aligned and
            // unaffected by the model's rotation/scale.
            a.xform->addChild(a.gizmoNode.get());
        }

        // Arrows must clear the model so their tips stay grabbable: longer than
        // both the displayed height and the footprint radius.
        double gizmoLength(const Asset& a) const
        {
            osg::BoundingBox bb = assetBBox(a);
            double height = ((double)bb.zMax() - (double)bb.zMin()) * a.scale * 1.15;
            double horiz = (double)bb.radius() * a.scale * 0.9;
            return clampBetween(std::max(height, horiz), 8.0, 250.0);
        }

        // The rotation ring hugs the model's footprint like a turntable.
        double gizmoRingRadius(const Asset& a) const
        {
            osg::BoundingBox bb = assetBBox(a);
            double dx = (double)bb.xMax() - (double)bb.xMin();
            double dy = (double)bb.yMax() - (double)bb.yMin();
            double halfDiag = 0.5 * std::sqrt(dx * dx + dy * dy);
            return clampBetween(halfDiag * a.scale * 1.15, 6.0, 200.0);
        }

        void updateGizmoSize(Asset& a)
        {
            if (!a.axisNode[0].valid()) return;
            double len = gizmoLength(a);
            osg::Matrixd S = osg::Matrixd::scale(len, len, len);
            a.axisNode[0]->setMatrix(S * osg::Matrixd::rotate(osg::PI_2, osg::Vec3d(0, 1, 0)));  // +Z -> +X (east)
            a.axisNode[1]->setMatrix(S * osg::Matrixd::rotate(-osg::PI_2, osg::Vec3d(1, 0, 0))); // +Z -> +Y (north)
            a.axisNode[2]->setMatrix(S);                                                          // up

            if (a.ringNode.valid())
            {
                double r = gizmoRingRadius(a);
                a.ringNode->setMatrix(osg::Matrixd::scale(r, r, r));
            }
            if (a.scaleNode.valid())
            {
                // diagonal (east+north+up) stalk with the cube tip clear of the model
                a.scaleNode->setMatrix(
                    osg::Matrixd::scale(len, len, len) *
                    osg::Matrixd::rotate(osg::Vec3d(0, 0, 1), osg::Vec3d(1, 1, 1)));
            }
        }

        static osg::Group* makeSelectionBox(const osg::BoundingBox& bb)
        {
            LineDrawable* lines = new LineDrawable(GL_LINES);
            static const int edges[24] = {
                0,1, 1,3, 3,2, 2,0,   // bottom
                4,5, 5,7, 7,6, 6,4,   // top
                0,4, 1,5, 2,6, 3,7 }; // verticals
            for (int i = 0; i < 24; ++i)
                lines->pushVertex(bb.corner(edges[i]));
            lines->setColor(osg::Vec4(1.0f, 0.9f, 0.1f, 1.0f));
            lines->setLineWidth(2.0f);
            lines->finish();

            osg::Group* group = new osg::Group();
            group->addChild(lines);
            group->setNodeMask(0); // off until selected
            return group;
        }

        void refreshSelectionGraphics()
        {
            for (int i = 0; i < (int)_assets.size(); ++i)
            {
                if (_assets[i].selectionNode.valid())
                    _assets[i].selectionNode->setNodeMask(i == _selected ? SELECTION_MASK : 0u);
                if (_assets[i].gizmoNode.valid())
                    _assets[i].gizmoNode->setNodeMask((i == _selected && _showGizmo) ? ~SELECTION_MASK : 0u);
            }
        }

        void selectAsset(int index)
        {
            _selected = index;
            refreshSelectionGraphics();
        }

        // When switching elevation modes, recompute the elevation value from the
        // asset's current resolved position so it stays visually in place.
        void convertElevationMode(Asset& a, bool toAbsolute)
        {
            if (!_mapNode.valid() || !a.xform.valid())
                return;

            const SpatialReference* mapSRS = _mapNode->getMapSRS();
            GeoPoint current;
            if (!current.fromWorld(mapSRS, a.xform->getMatrix().getTrans()) || !current.isValid())
                return;

            if (toAbsolute)
            {
                // absolute elevations are EGM96 (MSL) meters:
                const SpatialReference* egm96 = SpatialReference::get("wgs84", "egm96");
                if (egm96)
                {
                    GeoPoint msl = current.transform(egm96);
                    if (msl.isValid())
                    {
                        a.elevation = msl.alt();
                        a.writeElevation = true;
                    }
                }
            }
            else
            {
                // relative elevations are meters above the terrain:
                double terrainHAE = 0.0;
                osg::ref_ptr<Terrain> terrain = _mapNode->getTerrain();
                if (terrain.valid() &&
                    terrain->getHeight(mapSRS->getGeographicSRS(), a.lon, a.lat, nullptr, &terrainHAE))
                {
                    GeoPoint geo = current.transform(mapSRS->getGeographicSRS());
                    if (geo.isValid())
                    {
                        a.elevation = geo.alt() - terrainHAE;
                        a.writeElevation = true;
                    }
                }
            }
        }

        // Applies the geographic position. "relative" mode uses osgEarth's
        // relative-altitude clamping (base sits <elevation> m above terrain),
        // matching Prestige. "absolute" mode converts EGM96 (MSL) meters to
        // the map's vertical datum.
        void applyPosition(Asset& a)
        {
            if (!a.xform.valid() || !_mapNode.valid()) return;

            const SpatialReference* mapSRS = _mapNode->getMapSRS();
            const SpatialReference* geoSRS = mapSRS->getGeographicSRS();

            if (a.absolute)
            {
                const SpatialReference* egm96 = SpatialReference::get("wgs84", "egm96");
                GeoPoint p(egm96 ? egm96 : geoSRS, a.lon, a.lat, a.elevation, ALTMODE_ABSOLUTE);
                GeoPoint mapPos = p.transform(mapSRS);
                if (mapPos.isValid())
                    a.xform->setPosition(mapPos);
            }
            else
            {
                a.xform->setPosition(GeoPoint(geoSRS, a.lon, a.lat, a.elevation, ALTMODE_RELATIVE));
            }
        }

        // Local placement replicating prestige-cpp instantiateAssetTemplate():
        //   T(0,0,-groundZ*s) * Rz(rotation) * S(s) * T(-centerX,-centerY,0)
        // (column-vector order; reversed here for OSG's row-vector matrices)
        void applyLocalMatrix(Asset& a)
        {
            if (!a.local.valid()) return;

            osg::BoundingBox bb = assetBBox(a);
            double cx = 0.5 * ((double)bb.xMin() + (double)bb.xMax());
            double cy = 0.5 * ((double)bb.yMin() + (double)bb.yMax());
            double groundZ = (double)bb.zMin();
            double s = a.scale;

            osg::Matrixd m =
                osg::Matrixd::translate(-cx, -cy, 0.0) *
                osg::Matrixd::scale(s, s, s) *
                osg::Matrixd::rotate(osg::DegreesToRadians(a.rotation), osg::Vec3d(0.0, 0.0, 1.0)) *
                osg::Matrixd::translate(0.0, 0.0, -groundZ * s);

            a.local->setMatrix(m);
            updateGizmoSize(a);
        }

        void deleteAsset(int index)
        {
            if (index < 0 || index >= (int)_assets.size()) return;
            Asset& a = _assets[index];
            if (a.xform.valid() && _root.valid())
                _root->removeChild(a.xform.get());
            _assets.erase(_assets.begin() + index);
            if (_selected == index) _selected = -1;
            else if (_selected > index) _selected--;
            _dragAsset = -1;
            _dragMode = DRAG_NONE;
            refreshSelectionGraphics();
            markDirty();
        }

        void duplicateAsset(int index)
        {
            if (index < 0 || index >= (int)_assets.size()) return;

            Asset copy;
            const Asset& src = _assets[index];
            copy.name = uniqueName(src.name);
            copy.assetPath = src.assetPath;
            copy.lon = src.lon + 0.0002; // ~20m east so the copy is visible
            copy.lat = src.lat;
            copy.rotation = src.rotation;
            copy.scale = src.scale;
            copy.elevation = src.elevation;
            copy.absolute = src.absolute;
            copy.writeElevation = src.writeElevation;
            copy.writeElevationMode = src.writeElevationMode;
            copy.extraProps = src.extraProps;

            _assets.push_back(copy);
            buildAssetNode(_assets.back());
            selectAsset((int)_assets.size() - 1);
            markDirty();
        }

        void addAssetAt(const std::string& absFile, const GeoPoint& mapPoint)
        {
            GeoPoint geo = mapPoint.transform(mapPoint.getSRS()->getGeographicSRS());
            if (!geo.isValid())
                return;

            if (_projectRoot.empty())
                _projectRoot = _projectRootInput = osgDB::convertFileNameToUnixStyle(osgDB::getFilePath(absFile));

            Asset a;
            a.assetPath = toStoredPath(absFile);
            a.name = uniqueName(osgDB::getNameLessExtension(osgDB::getSimpleFileName(absFile)));
            a.lon = geo.x();
            a.lat = geo.y();

            _assets.push_back(a);
            buildAssetNode(_assets.back());
            selectAsset((int)_assets.size() - 1);
            markDirty();
            setStatus("Added " + a.name + " - drag it to position it.");
        }

        void zoomTo(const Asset& a)
        {
            if (!_view || !_mapNode.valid()) return;
            auto* manip = dynamic_cast<EarthManipulator*>(_view->getCameraManipulator());
            if (!manip) return;

            double radius = 50.0;
            osg::BoundingBox bb = assetBBox(a);
            if (bb.valid())
                radius = std::max(10.0, (double)bb.radius() * a.scale);

            // The manipulator needs an ABSOLUTE focal point; the stored position
            // may be ALTMODE_RELATIVE (terrain-clamped). The transform's matrix
            // already holds the resolved world position.
            GeoPoint focal;
            if (a.xform.valid())
                focal.fromWorld(_mapNode->getMapSRS(), a.xform->getMatrix().getTrans());
            if (!focal.isValid())
                focal = GeoPoint(_mapNode->getMapSRS()->getGeographicSRS(), a.lon, a.lat, 0.0, ALTMODE_ABSOLUTE);

            Viewpoint vp;
            vp.focalPoint() = focal;
            vp.pitch() = Angle(-35.0, Units::DEGREES);
            vp.range() = Distance(radius * 4.0, Units::METERS);
            manip->setViewpoint(vp, 1.0);
        }

        GeoPoint pointAtViewportCenter(osg::RenderInfo& ri)
        {
            if (!_view || !_mapNode.valid())
                return GeoPoint();
            const osg::Viewport* vp = camera(ri)->getViewport();
            if (!vp)
                return GeoPoint();
            return getPointAtMouse(_mapNode.get(), _view,
                (float)(vp->x() + vp->width() * 0.5), (float)(vp->y() + vp->height() * 0.5));
        }

        //-------------------------------------------------------------------
        // in-scene editing

        void installEventHandler()
        {
            if (_handler.valid() || !_view) return;
            _handler = new EditHandler(this);
            // push_back so the ImGui handler (at the front) sees events first.
            _view->getEventHandlers().push_back(_handler);
        }

        PickResult pickAt(osgViewer::View* v, float x, float y)
        {
            PickResult result;

            osgUtil::LineSegmentIntersector::Intersections hits;
            if (!v->getCamera() ||
                !v->computeIntersections(v->getCamera(), osgUtil::Intersector::WINDOW, x, y, hits, ~SELECTION_MASK))
            {
                return result;
            }

            // nearest-first; take the first hit that lies inside one of our
            // assets. Within a hit, a gizmo arrow wins over the model (the
            // arrow's path also contains the asset's transform).
            for (const auto& hit : hits)
            {
                for (const auto* node : hit.nodePath)
                {
                    for (size_t i = 0; i < _assets.size(); ++i)
                    {
                        const Asset& a = _assets[i];
                        for (int k = 0; k < 3; ++k)
                            if (a.axisNode[k].get() == node)
                            {
                                result.asset = (int)i;
                                result.axis = k;
                                return result;
                            }
                        if (a.ringNode.get() == node)
                        {
                            result.asset = (int)i;
                            result.axis = GIZMO_RING;
                            return result;
                        }
                        if (a.scaleNode.get() == node)
                        {
                            result.asset = (int)i;
                            result.axis = GIZMO_SCALE;
                            return result;
                        }
                    }
                }
                for (const auto* node : hit.nodePath)
                {
                    for (size_t i = 0; i < _assets.size(); ++i)
                        if (_assets[i].xform.get() == node)
                        {
                            result.asset = (int)i;
                            return result;
                        }
                }
            }

            return result;
        }

        // Signed angle (radians, CCW from east) of the pick ray's intersection
        // with the horizontal plane through the drag anchor. NaN if the ray is
        // parallel to the plane or hits at the anchor itself.
        double ringAngle(const osg::Vec3d& rayA, const osg::Vec3d& rayB) const
        {
            osg::Vec3d dir = rayB - rayA;
            double denom = dir * _enuUp;
            if (std::abs(denom) < 1.0e-12)
                return std::numeric_limits<double>::quiet_NaN();
            double s = ((_axisOrigin - rayA) * _enuUp) / denom;
            osg::Vec3d v = rayA + dir * s - _axisOrigin;
            double e = v * _enuEast;
            double n = v * _enuNorth;
            if (e * e + n * n < 1.0e-12)
                return std::numeric_limits<double>::quiet_NaN();
            return std::atan2(n, e);
        }

        static bool windowRay(osgViewer::View* v, float x, float y, osg::Vec3d& nearP, osg::Vec3d& farP)
        {
            osg::Camera* cam = v->getCamera();
            if (!cam || !cam->getViewport()) return false;
            osg::Matrixd VPW = cam->getViewMatrix() * cam->getProjectionMatrix() * cam->getViewport()->computeWindowMatrix();
            osg::Matrixd inv;
            if (!inv.invert(VPW)) return false;
            nearP = osg::Vec3d(x, y, 0.0) * inv;
            farP = osg::Vec3d(x, y, 1.0) * inv;
            return true;
        }

        // Parameter (meters) along the axis line (origin, unit dir) of the point
        // closest to the pick ray. NaN when the ray is near-parallel to the axis.
        static double axisParameter(const osg::Vec3d& rayA, const osg::Vec3d& rayB,
            const osg::Vec3d& origin, const osg::Vec3d& dir)
        {
            osg::Vec3d u = rayB - rayA;
            osg::Vec3d w0 = rayA - origin;
            double a = u * u;
            double b = u * dir;
            double d = u * w0;
            double e = dir * w0;
            double denom = a - b * b; // dir is unit length
            if (a <= 0.0 || denom < 1.0e-9 * a)
                return std::numeric_limits<double>::quiet_NaN();
            return (a * e - b * d) / denom;
        }

        bool handleEvent(const osgGA::GUIEventAdapter& ea, osgGA::GUIActionAdapter& aa)
        {
            if (!isVisible() || !_editingEnabled || !_mapNode.valid())
                return false;

            // An active drag session owns the mouse until the button releases,
            // even if the cursor strays over an ImGui window (which marks
            // events handled). Without this, a release over a panel would
            // leave the drag stuck on.
            bool dragSession = (_dragAsset >= 0);
            if (ea.getHandled() && !dragSession)
                return false;

            osgViewer::View* v = dynamic_cast<osgViewer::View*>(aa.asView());
            if (!v)
                return false;

            ImGuiIO* io = ImGui::GetCurrentContext() ? &ImGui::GetIO() : nullptr;

            switch (ea.getEventType())
            {
            case osgGA::GUIEventAdapter::PUSH:
            {
                if (ea.getButton() != osgGA::GUIEventAdapter::LEFT_MOUSE_BUTTON)
                    return false;
                if (io && io->WantCaptureMouse)
                    return false;

                PickResult pick = pickAt(v, ea.getX(), ea.getY());
                if (pick.asset < 0)
                    return false;

                selectAsset(pick.asset);
                _dragAsset = pick.asset;
                _pressX = ea.getX();
                _pressY = ea.getY();

                Asset& a = _assets[pick.asset];
                _startLon = a.lon;
                _startLat = a.lat;
                _startRotation = a.rotation;
                _startScale = a.scale;
                _startElevation = a.elevation;

                if (pick.axis >= 0)
                {
                    // grabbed a gizmo widget: capture the asset's ENU frame.
                    osg::Matrixd m = a.xform->getMatrix();
                    _axisOrigin = m.getTrans();
                    _enuEast.set(m(0, 0), m(0, 1), m(0, 2));  _enuEast.normalize();
                    _enuNorth.set(m(1, 0), m(1, 1), m(1, 2)); _enuNorth.normalize();
                    _enuUp.set(m(2, 0), m(2, 1), m(2, 2));    _enuUp.normalize();

                    osg::Vec3d rayA, rayB;
                    bool haveRay = windowRay(v, ea.getX(), ea.getY(), rayA, rayB);
                    const double nan = std::numeric_limits<double>::quiet_NaN();

                    if (pick.axis == GIZMO_RING)
                    {
                        _dragMode = DRAG_RING;
                        _ringAngle0 = haveRay ? ringAngle(rayA, rayB) : nan;
                    }
                    else if (pick.axis == GIZMO_SCALE)
                    {
                        _dragMode = DRAG_SCALE_HANDLE;
                        _axisDir = _enuEast + _enuNorth + _enuUp;
                        _axisDir.normalize();
                        _axisT0 = haveRay ? axisParameter(rayA, rayB, _axisOrigin, _axisDir) : nan;
                    }
                    else
                    {
                        // translate arrow
                        _dragMode = DRAG_AXIS;
                        _dragAxis = pick.axis;
                        _axisDir = pick.axis == 0 ? _enuEast : pick.axis == 1 ? _enuNorth : _enuUp;
                        _axisT0 = haveRay ? axisParameter(rayA, rayB, _axisOrigin, _axisDir) : nan;
                    }
                }
                else
                {
                    int mods = ea.getModKeyMask();
                    _dragMode =
                        (mods & osgGA::GUIEventAdapter::MODKEY_CTRL) ? DRAG_ROTATE :
                        (mods & osgGA::GUIEventAdapter::MODKEY_ALT) ? DRAG_SCALE :
                        DRAG_MOVE;
                }

                return true; // keep the camera manipulator from grabbing the gesture
            }

            case osgGA::GUIEventAdapter::DRAG:
            {
                if (_dragAsset < 0 || _dragAsset >= (int)_assets.size())
                    return false;

                Asset& a = _assets[_dragAsset];

                if (_dragMode == DRAG_MOVE)
                {
                    GeoPoint p = getPointAtMouse(_mapNode.get(), v, ea.getX(), ea.getY());
                    if (p.isValid())
                    {
                        GeoPoint geo = p.transform(p.getSRS()->getGeographicSRS());
                        if (geo.isValid())
                        {
                            a.lon = geo.x();
                            a.lat = geo.y();
                            applyPosition(a);
                            markDirty();
                        }
                    }
                }
                else if (_dragMode == DRAG_ROTATE)
                {
                    double dx = (double)ea.getX() - (double)_pressX;
                    a.rotation = normalizeDegrees(_startRotation + dx * 0.25);
                    applyLocalMatrix(a);
                    markDirty();
                }
                else if (_dragMode == DRAG_SCALE)
                {
                    double dy = (double)ea.getY() - (double)_pressY;
                    double s = _startScale * std::exp(dy * 0.01);
                    a.scale = clampBetween(s, 1.0e-9, 1.0e12);
                    applyLocalMatrix(a);
                    markDirty();
                }
                else if (_dragMode == DRAG_AXIS)
                {
                    osg::Vec3d rayA, rayB;
                    if (windowRay(v, ea.getX(), ea.getY(), rayA, rayB))
                    {
                        double t = axisParameter(rayA, rayB, _axisOrigin, _axisDir);
                        double d = t - _axisT0;
                        if (std::isfinite(d))
                        {
                            if (_dragAxis == 2)
                            {
                                a.elevation = _startElevation + d;
                                a.writeElevation = true;
                            }
                            else if (_dragAxis == 0)
                            {
                                double mPerDeg = 111319.49 * std::max(0.01, std::cos(osg::DegreesToRadians(_startLat)));
                                a.lon = _startLon + d / mPerDeg;
                            }
                            else
                            {
                                a.lat = clampBetween(_startLat + d / 111132.95, -90.0, 90.0);
                            }
                            applyPosition(a);
                            markDirty();
                        }
                    }
                }
                else if (_dragMode == DRAG_RING)
                {
                    osg::Vec3d rayA, rayB;
                    if (windowRay(v, ea.getX(), ea.getY(), rayA, rayB))
                    {
                        double angle = ringAngle(rayA, rayB);
                        if (std::isfinite(angle) && std::isfinite(_ringAngle0))
                        {
                            a.rotation = normalizeDegrees(_startRotation + osg::RadiansToDegrees(angle - _ringAngle0));
                            applyLocalMatrix(a);
                            markDirty();
                        }
                    }
                }
                else if (_dragMode == DRAG_SCALE_HANDLE)
                {
                    osg::Vec3d rayA, rayB;
                    if (windowRay(v, ea.getX(), ea.getY(), rayA, rayB))
                    {
                        double t = axisParameter(rayA, rayB, _axisOrigin, _axisDir);
                        if (std::isfinite(t) && std::isfinite(_axisT0) && _axisT0 > 1.0e-6)
                        {
                            // pulling the handle outward grows the model by the
                            // same ratio, like dragging the corner of a box.
                            double ratio = clampBetween(t / _axisT0, 0.01, 100.0);
                            a.scale = clampBetween(_startScale * ratio, 1.0e-9, 1.0e12);
                            applyLocalMatrix(a);
                            markDirty();
                        }
                    }
                }
                return true;
            }

            case osgGA::GUIEventAdapter::RELEASE:
            {
                if (ea.getButton() == osgGA::GUIEventAdapter::LEFT_MOUSE_BUTTON && _dragAsset >= 0)
                {
                    _dragAsset = -1;
                    _dragAxis = -1;
                    _dragMode = DRAG_NONE;
                    return true;
                }
                return false;
            }

            case osgGA::GUIEventAdapter::KEYDOWN:
            {
                if (io && io->WantCaptureKeyboard)
                    return false;

                if (ea.getKey() == osgGA::GUIEventAdapter::KEY_Escape)
                {
                    if (_dragAsset >= 0 && _dragAsset < (int)_assets.size())
                    {
                        // cancel the in-progress drag:
                        Asset& a = _assets[_dragAsset];
                        a.lon = _startLon;
                        a.lat = _startLat;
                        a.rotation = _startRotation;
                        a.scale = _startScale;
                        a.elevation = _startElevation;
                        applyPosition(a);
                        applyLocalMatrix(a);
                        _dragAsset = -1;
                        _dragAxis = -1;
                        _dragMode = DRAG_NONE;
                        return true;
                    }
                    if (_selected >= 0)
                    {
                        selectAsset(-1);
                        return true;
                    }
                }
                else if (ea.getKey() == osgGA::GUIEventAdapter::KEY_Delete)
                {
                    if (_selected >= 0 && _dragAsset < 0)
                    {
                        deleteAsset(_selected);
                        return true;
                    }
                }
                return false;
            }

            default:
                return false;
            }
        }

        //-------------------------------------------------------------------
        // OS drag-and-drop (Windows)

#ifdef _WIN32
        static PrestigeAssetsGUI*& s_dropInstance()
        {
            static PrestigeAssetsGUI* s = nullptr;
            return s;
        }
        static WNDPROC& s_prevWndProc()
        {
            static WNDPROC s = nullptr;
            return s;
        }
        static bool& s_wndIsUnicode()
        {
            static bool s = true;
            return s;
        }

        static LRESULT CALLBACK dropWndProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
        {
            if (msg == WM_DROPFILES && s_dropInstance())
            {
                HDROP hdrop = (HDROP)wParam;
                POINT pt = { 0, 0 };
                DragQueryPoint(hdrop, &pt);

                Drop drop;
                drop.clientX = (float)pt.x;
                drop.clientY = (float)pt.y;

                UINT count = DragQueryFileW(hdrop, 0xFFFFFFFF, NULL, 0);
                for (UINT i = 0; i < count; ++i)
                {
                    wchar_t path[MAX_PATH];
                    if (DragQueryFileW(hdrop, i, path, MAX_PATH) > 0)
                        drop.files.push_back(osgDB::convertUTF16toUTF8(path));
                }
                DragFinish(hdrop);

                if (!drop.files.empty())
                {
                    std::lock_guard<std::mutex> lock(s_dropInstance()->_dropMutex);
                    s_dropInstance()->_drops.push_back(drop);
                }
                return 0;
            }

            return s_wndIsUnicode() ?
                ::CallWindowProcW(s_prevWndProc(), hwnd, msg, wParam, lParam) :
                ::CallWindowProcA(s_prevWndProc(), hwnd, msg, wParam, lParam);
        }

        void installDropTarget(osg::RenderInfo& ri)
        {
            if (_dropInstalled) return;
            _dropInstalled = true;

            auto* gw = dynamic_cast<osgViewer::GraphicsWindowWin32*>(ri.getState()->getGraphicsContext());
            if (!gw) return;

            HWND hwnd = gw->getHWND();
            if (!hwnd) return;

            s_dropInstance() = this;
            s_wndIsUnicode() = (::IsWindowUnicode(hwnd) != FALSE);
            ::DragAcceptFiles(hwnd, TRUE);
            s_prevWndProc() = s_wndIsUnicode() ?
                (WNDPROC)::SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)&PrestigeAssetsGUI::dropWndProc) :
                (WNDPROC)::SetWindowLongPtrA(hwnd, GWLP_WNDPROC, (LONG_PTR)&PrestigeAssetsGUI::dropWndProc);
        }

        static std::string fileDialog(bool save, const wchar_t* filter, const wchar_t* defaultExt)
        {
            wchar_t buf[1024];
            buf[0] = 0;

            OPENFILENAMEW ofn;
            ZeroMemory(&ofn, sizeof(ofn));
            ofn.lStructSize = sizeof(ofn);
            ofn.hwndOwner = ::GetActiveWindow();
            ofn.lpstrFile = buf;
            ofn.nMaxFile = 1024;
            ofn.lpstrFilter = filter;
            ofn.nFilterIndex = 1;
            ofn.lpstrDefExt = defaultExt;
            ofn.Flags = OFN_NOCHANGEDIR | OFN_HIDEREADONLY |
                (save ? OFN_OVERWRITEPROMPT : (OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST));

            BOOL ok = save ? ::GetSaveFileNameW(&ofn) : ::GetOpenFileNameW(&ofn);
            if (!ok)
                return std::string();
            return osgDB::convertUTF16toUTF8(buf);
        }
#else
        void installDropTarget(osg::RenderInfo&) { }
#endif

        void processDrops(osg::RenderInfo& ri)
        {
            std::vector<Drop> drops;
            {
                std::lock_guard<std::mutex> lock(_dropMutex);
                drops.swap(_drops);
            }
            if (drops.empty()) return;

            if (!_view || !_mapNode.valid())
                return;

            const osg::Viewport* vp = camera(ri)->getViewport();
            double height = vp ? vp->height() : 0.0;

            for (const auto& d : drops)
            {
                // client coords are top-left origin; OSG events are bottom-left.
                float ex = d.clientX;
                float ey = (float)(height - d.clientY);

                GeoPoint p = getPointAtMouse(_mapNode.get(), _view, ex, ey);
                if (!p.isValid())
                    p = pointAtViewportCenter(ri);
                if (!p.isValid())
                {
                    setStatus("Could not find terrain under the drop point.");
                    continue;
                }

                int added = 0;
                for (const auto& f : d.files)
                {
                    if (!isModelFile(f))
                        continue;
                    // offset multiple files so they don't stack exactly:
                    GeoPoint place = p;
                    place.x() += 0.0002 * added;
                    addAssetAt(f, place);
                    ++added;
                }
                if (added == 0 && !d.files.empty())
                    setStatus("No recognized model files in the drop (expected .glb/.gltf/etc).");
            }
        }
