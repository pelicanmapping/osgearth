        static bool inputText(const char* id, std::string& value)
        {
            char buf[2048];
            snprintf(buf, sizeof(buf), "%s", value.c_str());
            if (ImGui::InputText(id, buf, sizeof(buf)))
            {
                value = buf;
                return true;
            }
            return false;
        }

