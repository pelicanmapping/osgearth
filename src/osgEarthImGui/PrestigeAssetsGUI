    /**
     * Editor for the Prestige "asset_points.geojson" format: a FeatureCollection
     * of Point features whose properties reference a GLB/glTF model to instance
     * at that location:
     *
     *   asset_path      model file, relative paths resolve against the project root
     *   name            display name
     *   rotation        degrees counter-clockwise around +up (0 = authored orientation)
     *   scale           uniform scale (1 = native size)
     *   elevation       meters (default 0)
     *   elevation_mode  "relative" (default): base sits <elevation> m above the terrain
     *                   "absolute": <elevation> is meters above the EGM96 geoid
     *
     * Placement matches prestige-cpp's instantiateAssetTemplate(): the model is
     * recentered on the XY center of its bounding box, its base (min Z) is
     * dropped to the placement height, and rotation/scale apply about that
     * recentered origin in the local ENU frame.
     *
     * Interactions: click a model to select it, drag to move it along the
     * terrain, Ctrl+drag to rotate, Alt+drag to scale. Files dragged from
     * Explorer onto the map are added where they are dropped (Windows).
     */
    class PrestigeAssetsGUI : public ImGuiPanel
    {
    public:
        PrestigeAssetsGUI() : ImGuiPanel("Prestige Assets")
        {
#ifdef _WIN32
            s_dropInstance() = this;
#endif
        }

        void load(const Config& conf) override
        {
            conf.get("LastFile", _pathInput);
            conf.get("ProjectRoot", _projectRootInput);
            conf.get("EditingEnabled", _editingEnabled);
            conf.get("ShowGizmo", _showGizmo);
        }

        void save(Config& conf) override
        {
            conf.set("LastFile", _pathInput);
            conf.set("ProjectRoot", _projectRootInput);
            conf.set("EditingEnabled", _editingEnabled);
            conf.set("ShowGizmo", _showGizmo);
        }

        void draw(osg::RenderInfo& ri) override
        {
            if (!isVisible()) return;
            if (!findNodeOrHide(_mapNode, ri)) return;

            _view = view(ri);

            if (!_root.valid())
            {
                _root = new osg::Group();
                _root->setName("Prestige Assets (editor)");
            }
            if (_root->getNumParents() == 0)
                _mapNode->addChild(_root);

            installEventHandler();
            installDropTarget(ri);

            // restore the previous session's file the first time the panel shows:
            if (_autoRestore)
            {
                _autoRestore = false;
                if (_filePath.empty() && !_pathInput.empty() && osgDB::fileExists(_pathInput))
                {
                    std::string savedRoot = _projectRootInput;
                    loadFile(_pathInput);
                    if (!savedRoot.empty() && savedRoot != _projectRoot)
                    {
                        _projectRoot = _projectRootInput = savedRoot;
                        reresolveModels();
                    }
                }
            }

            processDrops(ri);
            updateModels();

            ImGui::Begin(name(), visible());
            {
                drawFileSection(ri);
                ImGui::Separator();
                drawEditSection(ri);

                if (_selected >= 0 && _selected < (int)_assets.size())
                {
                    ImGui::Separator();
                    drawSelectedEditor(ri);
                }

                ImGui::Separator();
                drawAssetTable(ri);

                if (!_status.empty())
                {
                    ImGui::Separator();
                    ImGui::TextWrapped("%s", _status.c_str());
                }
            }
            ImGui::End();
        }

    public:

        // node mask for selection-highlight geometry; excluded when picking.
        static constexpr unsigned SELECTION_MASK = 0x08000000u;

        struct ModelEntry : public osg::Referenced
        {
            std::string absPath;
            Threading::Future<osg::ref_ptr<osg::Node>> future;
            osg::ref_ptr<osg::Node> node;
            osg::BoundingBox bbox;
            bool pending = true;
            bool failed = false;
        };

        struct Asset
        {
            // geojson content:
            std::string name;
            std::string assetPath;       // as stored in the file (may be relative)
            double lon = 0.0;
            double lat = 0.0;
            double rotation = 0.0;       // degrees CCW around up
            double scale = 1.0;
            double elevation = 0.0;
            bool absolute = false;       // elevation_mode == "absolute"
            bool writeElevation = false;
            bool writeElevationMode = false;
            Json::Value extraProps = Json::Value(Json::objectValue); // preserved verbatim

            // runtime:
            osg::ref_ptr<GeoTransform> xform;
            osg::ref_ptr<osg::MatrixTransform> local;
            osg::ref_ptr<osg::Group> selectionNode;
            osg::ref_ptr<osg::Group> gizmoNode;             // translate/rotate/scale widgets
            osg::ref_ptr<osg::MatrixTransform> axisNode[3]; // 0=east 1=north 2=up
            osg::ref_ptr<osg::MatrixTransform> ringNode;    // heading rotation ring
            osg::ref_ptr<osg::MatrixTransform> scaleNode;   // uniform scale handle
            osg::ref_ptr<ModelEntry> model;
            bool attached = false;
        };

        //! The assets currently loaded in the editor.
        const std::vector<Asset>& assets() const { return _assets; }

    private:

        enum DragMode { DRAG_NONE, DRAG_MOVE, DRAG_ROTATE, DRAG_SCALE, DRAG_AXIS, DRAG_RING, DRAG_SCALE_HANDLE };

        // pick classification for PickResult::axis
        static constexpr int GIZMO_RING = 3;
        static constexpr int GIZMO_SCALE = 4;

        struct PickResult
        {
            int asset = -1;
            int axis = -1;  // 0=east 1=north 2=up, 3=rotate ring, 4=scale handle, -1=the model
        };

