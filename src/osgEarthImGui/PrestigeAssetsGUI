        {
        public:
            EditHandler(PrestigeAssetsGUI* gui) : _gui(gui) { }
            bool handle(const osgGA::GUIEventAdapter& ea, osgGA::GUIActionAdapter& aa) override
            {
                return _gui ? _gui->handleEvent(ea, aa) : false;
            }
            PrestigeAssetsGUI* _gui;
        };

        struct Drop
        {
            std::vector<std::string> files;
            float clientX = 0.0f;
            float clientY = 0.0f;
        };

        osg::observer_ptr<MapNode> _mapNode;
        // NOTE: raw pointer on purpose. The viewer is typically stack-allocated
        // (refcount 0), so an observer_ptr can never lock() it. It is refreshed
        // every frame in draw() and outlives this panel.
        osgViewer::View* _view = nullptr;
        osg::ref_ptr<osg::Group> _root;
        osg::ref_ptr<EditHandler> _handler;
        std::vector<Asset> _assets;
        std::map<std::string, osg::ref_ptr<ModelEntry>> _models;
        int _selected = -1;
        bool _dirty = false;
        bool _editingEnabled = true;
        bool _autoRestore = true;
        std::string _filePath;           // currently loaded file
        std::string _projectRoot;        // base for relative asset_path values
        std::string _pathInput;          // path text field
        std::string _projectRootInput;   // project root text field
        std::string _status;
        Json::Value _docExtras = Json::Value(Json::objectValue);   // extra top-level members
        std::vector<Json::Value> _foreignFeatures;                 // non-point features, kept verbatim

        // in-scene drag state:
        DragMode _dragMode = DRAG_NONE;
        int _dragAsset = -1;
        int _dragAxis = -1;
        float _pressX = 0.0f, _pressY = 0.0f;
        double _startLon = 0.0, _startLat = 0.0, _startRotation = 0.0, _startScale = 1.0;
        double _startElevation = 0.0;
        osg::Vec3d _axisOrigin, _axisDir;
        osg::Vec3d _enuEast, _enuNorth, _enuUp;
        double _axisT0 = 0.0;
        double _ringAngle0 = 0.0;
        bool _showGizmo = true;

        // drag-and-drop from the OS:
        std::mutex _dropMutex;
        std::vector<Drop> _drops;
        bool _dropInstalled = false;

        //-------------------------------------------------------------------
        // UI sections

        void drawFileSection(osg::RenderInfo& ri)
        {
            ImGui::TextDisabled("GeoJSON file:");

            if (ImGui::Button("Open..."))
            {
#ifdef _WIN32
                std::string file = fileDialog(false, L"GeoJSON (*.geojson;*.json)\0*.geojson;*.json\0All files (*.*)\0*.*\0", L"geojson");
                if (!file.empty())
                {
                    _pathInput = file;
                    loadFile(file);
                }
#else
                if (!_pathInput.empty())
                    loadFile(_pathInput);
#endif
                dirtySettings();
            }

            ImGui::SameLine();
            ImGui::BeginDisabled(_filePath.empty());
            if (ImGui::Button("Save"))
            {
                saveFile(_filePath);
            }
            ImGui::EndDisabled();

            ImGui::SameLine();
            ImGui::BeginDisabled(_assets.empty() && _filePath.empty());
            if (ImGui::Button("Save As..."))
            {
#ifdef _WIN32
                std::string file = fileDialog(true, L"GeoJSON (*.geojson;*.json)\0*.geojson;*.json\0All files (*.*)\0*.*\0", L"geojson");
                if (!file.empty())
                {
                    if (saveFile(file))
                        _pathInput = file;
                }
#else
                if (!_pathInput.empty() && saveFile(_pathInput))
                    ;
#endif
                dirtySettings();
            }
            ImGui::EndDisabled();

            if (_dirty)
            {
                ImGui::SameLine();
                ImGui::TextColored(ImVec4(1.0f, 0.65f, 0.0f, 1.0f), "(unsaved changes)");
            }

            // editable path field + manual load, for typing paths directly:
            ImGui::SetNextItemWidth(-70.0f);
            inputText("##filepath", _pathInput);
            ImGui::SameLine();
            if (ImGui::Button("Load"))
            {
                loadFile(_pathInput);
                dirtySettings();
            }
            if (ImGui::IsItemHovered())
                ImGui::SetTooltip("Load the geojson file entered in the text box");

            // project root:
            ImGui::TextDisabled("Project root (for relative asset paths):");
            ImGui::SetNextItemWidth(-70.0f);
            inputText("##projroot", _projectRootInput);
            ImGui::SameLine();
            if (ImGui::Button("Apply"))
            {
                _projectRoot = osgDB::convertFileNameToUnixStyle(_projectRootInput);
                reresolveModels();
                dirtySettings();
            }
        }

        void drawEditSection(osg::RenderInfo& ri)
        {
            if (ImGui::Checkbox("Enable editing in the scene", &_editingEnabled))
                dirtySettings();

            ImGui::SameLine(0.0f, 20.0f);
            if (ImGui::Checkbox("Move arrows", &_showGizmo))
            {
                refreshSelectionGraphics();
                dirtySettings();
            }
            if (ImGui::IsItemHovered())
                ImGui::SetTooltip("Show edit widgets on the selected model:\narrows = move (blue = elevation), orange ring = rotate, purple cube = scale.");

            ImGui::SameLine(0.0f, 20.0f);
            if (ImGui::Button("Add model..."))
            {
#ifdef _WIN32
                std::string file = fileDialog(false,
                    L"3D models\0*.glb;*.gltf;*.obj;*.osgb;*.osgt;*.osg;*.ive;*.fbx;*.dae;*.3ds\0All files (*.*)\0*.*\0",
                    nullptr);
                if (!file.empty())
                {
                    GeoPoint p = pointAtViewportCenter(ri);
                    if (p.isValid())
                        addAssetAt(file, p);
                    else
                        setStatus("Could not find terrain at the center of the view - move the camera and try again.");
                }
#else
                setStatus("Drag and drop a model file onto the map to add it.");
#endif
            }

            ImGui::TextWrapped("Click a model to select it, then drag it to move it along the terrain.");
            ImGui::TextWrapped("Widgets: red/green/blue arrows = move east/north/up, orange ring = rotate, purple cube = scale.");
            ImGui::TextWrapped("Drop model files onto the map to add them. Esc = cancel drag / deselect. Del = delete.");
        }

        void drawSelectedEditor(osg::RenderInfo& ri)
        {
            Asset& a = _assets[_selected];

            ImGui::Text("Selected: %s", a.name.c_str());

            if (ImGuiLTable::Begin("selectedAsset"))
            {
                labelRow("Name");
                if (inputText("##name", a.name))
                {
                    if (a.xform.valid())
                        a.xform->setName(a.name);
                    markDirty();
                }

                labelRow("Model");
                ImGui::TextWrapped("%s", a.assetPath.c_str());
                if (ImGui::IsItemHovered() && a.model.valid())
                    ImGui::SetTooltip("%s", a.model->absPath.c_str());

                if (a.model.valid() && a.model->failed)
                {
                    labelRow("Status");
                    ImGui::TextColored(ImVec4(1, 0.3f, 0.3f, 1), "failed to load (placeholder shown)");
                }
                else if (a.model.valid() && a.model->pending)
                {
                    labelRow("Status");
                    ImGui::TextDisabled("loading...");
                }

                labelRow("Longitude");
                double lon = a.lon;
                if (ImGui::InputDouble("##lon", &lon, 0.0, 0.0, "%.9f"))
                {
                    a.lon = lon;
                    applyPosition(a);
                    markDirty();
                }

                labelRow("Latitude");
                double lat = a.lat;
                if (ImGui::InputDouble("##lat", &lat, 0.0, 0.0, "%.9f"))
                {
                    a.lat = clampBetween(lat, -90.0, 90.0);
                    applyPosition(a);
                    markDirty();
                }

                labelRow("Rotation");
                float rot = (float)a.rotation;
                if (ImGui::DragFloat("##rotation", &rot, 0.25f, 0.0f, 0.0f, "%.2f deg CCW"))
                {
                    a.rotation = normalizeDegrees((double)rot);
                    applyLocalMatrix(a);
                    markDirty();
                }

                labelRow("Scale");
                float scale = (float)a.scale;
                if (ImGui::DragFloat("##scale", &scale, std::max(0.0001f, scale * 0.01f), 1.0e-6f, 1.0e8f, "%.6g", ImGuiSliderFlags_Logarithmic))
                {
                    if (scale > 0.0f)
                    {
                        a.scale = (double)scale;
                        applyLocalMatrix(a);
                        markDirty();
                    }
                }

                labelRow("Elevation");
                double elev = a.elevation;
                if (ImGui::InputDouble("##elev", &elev, 0.0, 0.0, "%.3f"))
                {
                    a.elevation = elev;
                    a.writeElevation = true;
                    applyPosition(a);
                    markDirty();
                }

                labelRow("Elev. mode");
                int mode = a.absolute ? 1 : 0;
                if (ImGui::Combo("##elevmode", &mode, "relative to terrain\0absolute (EGM96 meters)\0"))
                {
                    bool nowAbsolute = (mode == 1);
                    if (nowAbsolute != a.absolute)
                    {
                        // convert the elevation value so the model stays put:
                        convertElevationMode(a, nowAbsolute);
                        a.absolute = nowAbsolute;
                        a.writeElevationMode = true;
                        applyPosition(a);
                        markDirty();
                    }
                }

                ImGuiLTable::End();
            }

            if (ImGui::Button("Zoom to"))
                zoomTo(a);

            ImGui::SameLine();
            if (ImGui::Button("Duplicate"))
                duplicateAsset(_selected);

            ImGui::SameLine();
            if (ImGui::Button("Delete"))
                deleteAsset(_selected);

            ImGui::SameLine();
            if (ImGui::Button("Deselect"))
                selectAsset(-1);
        }

        void drawAssetTable(osg::RenderInfo& ri)
        {
            ImGui::Text("Assets (%d)", (int)_assets.size());

            const ImGuiTableFlags flags =
                ImGuiTableFlags_RowBg | ImGuiTableFlags_BordersInnerV |
                ImGuiTableFlags_ScrollY | ImGuiTableFlags_SizingStretchProp;

            float height = std::min(300.0f, 60.0f + (float)_assets.size() * ImGui::GetTextLineHeightWithSpacing());

            if (ImGui::BeginTable("assetTable", 4, flags, ImVec2(0, height)))
            {
                ImGui::TableSetupScrollFreeze(0, 1);
                ImGui::TableSetupColumn("Name", ImGuiTableColumnFlags_WidthStretch, 3.0f);
                ImGui::TableSetupColumn("Rotation", ImGuiTableColumnFlags_WidthStretch, 1.0f);
                ImGui::TableSetupColumn("Scale", ImGuiTableColumnFlags_WidthStretch, 1.0f);
                ImGui::TableSetupColumn("Status", ImGuiTableColumnFlags_WidthStretch, 1.0f);
                ImGui::TableHeadersRow();

                for (int i = 0; i < (int)_assets.size(); ++i)
                {
                    Asset& a = _assets[i];
                    ImGui::PushID(i);
                    ImGui::TableNextRow();
                    ImGui::TableNextColumn();

                    bool selected = (i == _selected);
                    if (ImGui::Selectable(a.name.c_str(), selected,
                        ImGuiSelectableFlags_SpanAllColumns | ImGuiSelectableFlags_AllowDoubleClick))
                    {
                        selectAsset(i);
                        if (ImGui::IsMouseDoubleClicked(0))
                            zoomTo(a);
                    }
                    if (ImGui::IsItemHovered())
                        ImGui::SetTooltip("%s\nDouble-click to zoom", a.assetPath.c_str());

                    ImGui::TableNextColumn();
                    ImGui::Text("%.2f", a.rotation);

                    ImGui::TableNextColumn();
                    ImGui::Text("%.5g", a.scale);

                    ImGui::TableNextColumn();
                    if (a.model.valid() && a.model->failed)
                        ImGui::TextColored(ImVec4(1, 0.3f, 0.3f, 1), "missing");
                    else if (a.model.valid() && a.model->pending)
                        ImGui::TextDisabled("loading");
                    else
                        ImGui::TextDisabled("ok");

                    ImGui::PopID();
                }
                ImGui::EndTable();
            }
        }

