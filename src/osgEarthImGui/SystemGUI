        const int frame_count = 300;
        using Counts = std::vector<unsigned>;
        using Timings = std::vector<std::chrono::nanoseconds>;
        Timings frame_times(frame_count);
        Counts total_jobs(frame_count);
        Counts ico_jobs(frame_count);
        std::chrono::time_point<std::chrono::steady_clock> t_previous;
        int frame_num = 0;
        char buf[256];
        float get_counts(void* data, int index) {
            return (float)(*(Counts*)data)[index];
        };
        unsigned long long get_average_timing_ns(void* data, int count, int start) {
            Timings& t = *(Timings*)(data);
            unsigned long long total = 0;
            int s = start - count; if (s < 0) s += frame_count;
            for (int i = s; i <= s + count; i++)
                total += t[i % frame_count].count();
            return (total / count);
        }
        float get_timing_ms(void* data, int index) {
            return 1e-6 * get_average_timing_ns(data, 4, index - 3);
        };
    };

    class SystemGUI : public ImGuiPanel
    {
    private:
        struct TimingPlot
        {
            const char* label;
            std::string attribute;
            ImU32 color;
            std::array<float, frame_count> samples{};
            int count = 0;
            int next = 0;

            //! Draw the timing row only when OSG has a recent average for this attribute.
            void draw(const osg::Stats* stats)
            {
                double seconds = 0.0;
                if (!stats || !stats->getAveragedAttribute(attribute, seconds))
                    return;

                const double ms = seconds * 1000.0;
                char overlay[32];
                snprintf(overlay, sizeof(overlay), "%.1f ms", ms);
                samples[next] = static_cast<float>(ms);
                next = (next + 1) % frame_count;
                count = std::min(count + 1, frame_count);
                ImGui::PushStyleColor(ImGuiCol_PlotLines, color);
                ImGuiLTable::PlotShaded(label, [](void* data, int index) { return static_cast<float*>(data)[index]; },
                    samples.data(), count, count == frame_count ? next : 0, overlay, 0.0f, 16.0f);
                ImGui::PopStyleColor();
            }
        };
        TimingPlot _viewerPlots[2] = {
            { "Event", "Event traversal time taken", IM_COL32(0, 255, 0, 255) },
            { "Update", "Update traversal time taken", IM_COL32(255, 0, 255, 255) }
        };
        TimingPlot _cameraPlots[3] = {
            { "Cull", "Cull traversal time taken", IM_COL32(0, 255, 255, 255) },
            { "Draw", "Draw traversal time taken", IM_COL32(255, 255, 0, 255) },
            { "GPU", "GPU draw time taken", IM_COL32(255, 128, 0, 255) }
        };
        std::atomic_bool _timingsRequested{false};
        struct TimingGroups
        {
            struct Group
            {
                const char* name;
                bool enabledByPanel = false;
            };
            Group groups[2];
            osg::ref_ptr<osg::Stats> stats;

            //! Check between frames whether the target changed or another consumer disabled collection.
            bool needsSync(osg::Stats* target) const
            {
                return stats.get() != target || (target &&
                    (!target->collectStats(groups[0].name) || !target->collectStats(groups[1].name)));
            }

            //! With graphics threads stopped, release our flags on the old source and enable missing groups on the new one.
            void sync(osg::Stats* target, bool hudActive)
            {
                for (auto& group : groups)
                {
                    if (stats.get() != target)
                    {
                        if (group.enabledByPanel && !hudActive)
                            stats->collectStats(group.name, false);
                        group.enabledByPanel = false;
                    }
                    if (target && !target->collectStats(group.name))
                    {
                        target->collectStats(group.name, true);
                        group.enabledByPanel = true;
                    }
                }
                stats = target;
            }
        };
        TimingGroups _viewerTimingGroups{ { { "event" }, { "update" } } };
        TimingGroups _cameraTimingGroups{ { { "rendering" }, { "gpu" } } };
        bool _usingSyncedStats = false;

        //! Check one view's native HUD before releasing timing groups that the HUD may also need.
        static bool nativeTimingHudActive(const osgViewer::View& view)
        {
            for (const auto& handler : view.getEventHandlers())
            {
                const auto* hud = dynamic_cast<const osgViewer::StatsHandler*>(handler.get());
                const auto* camera = hud ? hud->getCamera() : nullptr;
                if (!camera || !camera->getNodeMask() || camera->getNumChildren() == 0)
                    continue;

                // OSG's HUD switch has one child per visible StatsType, starting with FRAME_RATE.
                const auto* pages = camera->getChild(0)->asSwitch();
                constexpr unsigned timingPage = osgViewer::StatsHandler::VIEWER_STATS - osgViewer::StatsHandler::FRAME_RATE;
                if (pages && pages->getNumChildren() > timingPage && pages->getValue(timingPage))
                    return true;
            }
            return false;
        }

        std::string _renderMode;
        bool _renderViewNormals;
        bool _renderModelNormals;
        bool _renderWinding;
        bool _renderOutlines;
        bool _showArenaControls;
        float _dpr = 1.0f;
        float _fontScale = 1.0f;
        bool _first = true;

#ifdef _WIN32
        // Shared across panels to match the process-wide Registry DPR function.
        inline static bool _autoDPR = true;

        //! Apply Windows DPI scaling or unit scaling before rendering starts or on the GUI thread.
        static void applyAutoDPR()
        {
            if (_autoDPR)
            {
                Registry::instance()->setDevicePixelRatioFunction([](osg::GraphicsContext* gc)
                    {
                        if (gc)
                        {
                            auto win = dynamic_cast<osgViewer::GraphicsWindowWin32*>(gc);
                            if (win) return GetDpiForWindow(win->getHWND()) / 96.0f;
                        }
                        return GetDpiForSystem() / 96.0f;
                    });
            }
            else
            {
                Registry::instance()->setDevicePixelRatioFunction(
                    [](osg::GraphicsContext*) { return 1.0f; });
            }
        }
#endif

        //! Editable snapshot; native ICO setters are applied together between frames.
        struct ICOSettings
        {
            int maxObjects = 20;
            float minimumMS = 1.0f;
            float targetFPS = 100.0f;
            float spareRatio = 0.5f;
            float flushRatio = 0.5f;

            //! Capture the running ICO, including overrides supplied through OSG environment variables.
            void read(const osgUtil::IncrementalCompileOperation& ico)
            {
                maxObjects = static_cast<int>(ico.getMaximumNumOfObjectsToCompilePerFrame());
                minimumMS = static_cast<float>(1000.0 * ico.getMinimumTimeAvailableForGLCompileAndDeletePerFrame());
                targetFPS = static_cast<float>(ico.getTargetFrameRate());
                spareRatio = static_cast<float>(ico.getConservativeTimeRatio());
                flushRatio = static_cast<float>(ico.getFlushTimeRatio());
            }

            //! Apply valid slider values with all of the owning viewer's graphics threads stopped.
            void apply(osgUtil::IncrementalCompileOperation& ico) const
            {
                ico.setMaximumNumOfObjectsToCompilePerFrame(static_cast<unsigned>(maxObjects));
                ico.setMinimumTimeAvailableForGLCompileAndDeletePerFrame(minimumMS * 0.001);
                ico.setTargetFrameRate(targetFPS);
                ico.setConservativeTimeRatio(spareRatio);
                ico.setFlushTimeRatio(flushRatio);
            }
        };
        osg::observer_ptr<osgUtil::IncrementalCompileOperation> _ico;
        ICOSettings _icoSettings, _icoInitialSettings;

        //! Edit the current view's ICO without replacing it or changing its VAO protection.
        //! Changes are session-only; opening this panel preserves the running configuration.
        void drawICO(osg::RenderInfo& ri)
        {
            if (!ImGui::CollapsingHeader("Incremental compile (ICO)", ImGuiTreeNodeFlags_DefaultOpen))
                return;

            auto* currentView = view(ri);
            auto* viewer = currentView ? currentView->getViewerBase() : nullptr;
            auto* pager = currentView ? currentView->getDatabasePager() : nullptr;
            osg::ref_ptr<osgUtil::IncrementalCompileOperation> ico =
                pager ? pager->getIncrementalCompileOperation() : nullptr;
            if (!ico || !viewer)
            {
                _ico = nullptr;
                ImGui::TextDisabled("ICO is disabled. Use --ico to enable it");
                return;
            }
            if (_ico.get() != ico.get())
            {
                _ico = ico;
                _icoSettings.read(*ico);
                _icoInitialSettings = _icoSettings;
            }

            bool changed = false;
            const auto clamp = ImGuiSliderFlags_AlwaysClamp;
            if (ImGuiLTable::Begin("ICO settings"))
            {
                changed |= ImGuiLTable::SliderInt("Max objects / frame", &_icoSettings.maxObjects, 1, 100, "%d", clamp);
                if (ImGui::IsItemHovered()) ImGui::SetTooltip(
                    "Lower values spread compilation across more frames.\n"
                    "One drawable counts as one object, even if it uploads several buffers.");
                changed |= ImGuiLTable::SliderFloat("Minimum time (ms)", &_icoSettings.minimumMS,
                    0.01f, 10.0f, "%.2f ms", clamp | ImGuiSliderFlags_Logarithmic);
                if (ImGui::IsItemHovered()) ImGui::SetTooltip(
                    "Minimum time reserved for compilation and deletion, even on a busy frame.\n"
                    "This is a floor, not a maximum. Lower it to reduce work on busy frames.");
                changed |= ImGuiLTable::SliderFloat("Spare time fraction", &_icoSettings.spareRatio,
                    0.1f, 1.0f, "%.2f", clamp);
                if (ImGui::IsItemHovered()) ImGui::SetTooltip(
                    "Fraction of time left in the target frame that ICO may use. Lower values favor smoother frames.");
                changed |= ImGuiLTable::SliderFloat("Target frame rate", &_icoSettings.targetFPS,
                    1.0f, 360.0f, "%.0f fps", clamp);
                if (ImGui::IsItemHovered()) ImGui::SetTooltip(
                    "Used to estimate spare time; this does not limit the viewer's frame rate.\n"
                    "A higher target leaves less time for ICO work.");
                changed |= ImGuiLTable::SliderFloat("Deletion time fraction", &_icoSettings.flushRatio,
                    0.1f, 0.9f, "%.2f", clamp);
                if (ImGui::IsItemHovered()) ImGui::SetTooltip(
                    "Share of ICO time reserved for deleting GL objects. Unused deletion time can go to compilation.");
                ImGuiLTable::End();
            }
            if (ImGui::Button("Low frame impact"))
            {
                _icoSettings.maxObjects = 1;
                _icoSettings.minimumMS = 0.1f;
                _icoSettings.spareRatio = 0.1f;
                changed = true;
            }
            ImGui::SameLine();
            if (ImGui::Button("Restore initial settings"))
            {
                _icoSettings = _icoInitialSettings;
                changed = true;
            }
            ImGui::TextWrapped("Soft limits: an individual upload cannot be interrupted. Lower limits can slow paging.");

            if (changed)
            {
                const auto settings = _icoSettings;
                // ICO's native settings are not atomic. Quiesce threaded rendering before changing them;
                // never stop a graphics thread from inside its own GUI draw callback.
                viewer->addUpdateOperation(new OneTimer([viewer, ico, settings]()
                {
                    const bool threaded = viewer->areThreadsRunning();
                    if (threaded) viewer->stopThreading();
                    settings.apply(*ico);
                    if (threaded) viewer->startThreading();
                }));
            }
        }

    public:
        //! Initialize default DPI scaling; subsequently loaded settings can override it.
        SystemGUI() : ImGuiPanel("System"),
            _renderViewNormals(false), _renderModelNormals(false),
            _renderWinding(false), _renderOutlines(false),
            _showArenaControls(false)
        {
#ifdef _WIN32
            applyAutoDPR();
#endif
        }

        //! Call once between frames on the viewer thread, including while hidden. The camera selects
        //! the Cull, Draw and GPU source. Event and Update come from the owning viewer.
        void syncTimingCollection(osgViewer::ViewerBase& viewer, osg::Camera& camera)
        {
            const bool requested = _timingsRequested.exchange(false, std::memory_order_relaxed);
            if (!requested && !_usingSyncedStats)
                return;

            auto* viewerStats = requested ? viewer.getViewerStats() : nullptr;
            auto* cameraStats = requested ? camera.getStats() : nullptr;
            if (requested == _usingSyncedStats &&
                !_viewerTimingGroups.needsSync(viewerStats) && !_cameraTimingGroups.needsSync(cameraStats))
                return;

            bool hudActive = false;
            if ((_viewerTimingGroups.stats && _viewerTimingGroups.stats.get() != viewerStats) ||
                (_cameraTimingGroups.stats && _cameraTimingGroups.stats.get() != cameraStats))
            {
                osgViewer::ViewerBase::Views views;
                viewer.getViews(views, false);
                for (const auto* view : views)
                {
                    if (view && nativeTimingHudActive(*view))
                    {
                        hudActive = true;
                        break;
                    }
                }
            }

            // Both the OSG collection flags and the draw thread's stats bindings change here.
            const bool threaded = viewer.areThreadsRunning();
            if (threaded) viewer.stopThreading();
            if (_cameraTimingGroups.stats && cameraStats && _cameraTimingGroups.stats.get() != cameraStats)
            {
                for (auto& plot : _cameraPlots)
                    plot.count = plot.next = 0;
            }
            _viewerTimingGroups.sync(viewerStats, hudActive);
            _cameraTimingGroups.sync(cameraStats, hudActive);
            _usingSyncedStats = requested;
            if (threaded) viewer.startThreading();
        }

        //! Use the main camera for callers with a single-view Viewer.
        void syncTimingCollection(osgViewer::Viewer& viewer)
        {
            syncTimingCollection(viewer, *viewer.getCamera());
        }

        void load(const Config& conf) override
        {
            conf.get("System.fontScale", _fontScale);
#ifdef _WIN32
            if (conf.get("System.autoDPR", _autoDPR))
                applyAutoDPR();
#endif
        }

        void save(Config& conf) override
        {
            conf.set("System.fontScale", _fontScale);
#ifdef _WIN32
            conf.set("System.autoDPR", _autoDPR);
#endif
        }

        //! Refresh UI scaling on the GUI thread, including when this panel is closed.
        void update(osg::RenderInfo& ri) override
        {
            _dpr = Registry::instance()->getDevicePixelRatio(ri.getCurrentCamera()->getGraphicsContext());
            ImGui::GetIO().FontGlobalScale = _dpr * _fontScale;
        }

        void draw(osg::RenderInfo& ri) override
        {
            if (!isVisible())
                return;

            ImGui::Begin(name(), visible());
            {
                auto pb = Memory::getProcessPrivateUsage();
                ImGui::Text("Mem Alloc: %.1lf MB",
                    (double)(pb - osgEarth::g_startupPrivateBytes) / 1048576.0);
                ImGui::SameLine();
                ImGui::Text(" Total: %.1lf MB", (double)pb / 1048576.0);

                ImGui::Separator();

                if (ImGuiLTable::Begin("SystemGUIPlots"))
                {
                    int f = frame_num++ % frame_count;
                    auto now = std::chrono::steady_clock::now();
                    frame_times[f] = now - t_previous;
                    t_previous = now;
                    auto avg_timing_ms = 1e-6 * (float)get_average_timing_ns(&frame_times, 120, f);
                    snprintf( buf, sizeof(buf), "%.1f ms / %d fps", avg_timing_ms, (int)std::ceil(1000.0 / avg_timing_ms));
                    ImGuiLTable::PlotShaded("Frame", get_timing_ms, &frame_times, frame_count, frame_num, buf, 0.0f, 32.0f);

                    _timingsRequested.store(true, std::memory_order_relaxed);
                    auto* currentView = view(ri);
                    auto* viewer = currentView->getViewerBase();
                    const auto* viewerStats = _usingSyncedStats ? _viewerTimingGroups.stats.get() :
                        (viewer ? viewer->getViewerStats() : nullptr);
                    for (auto& plot : _viewerPlots)
                        plot.draw(viewerStats);
                    const auto* stats = _usingSyncedStats ? _cameraTimingGroups.stats.get() :
                        currentView->getCamera()->getStats();
                    for (auto& plot : _cameraPlots)
                        plot.draw(stats);

                    total_jobs[f] = jobs::get_metrics()->total();
                    snprintf(buf, sizeof(buf), "%d", total_jobs[f]);
                    ImGuiLTable::PlotShaded("Jobs", get_counts, &total_jobs, frame_count, frame_num, buf, 0u, 100u);

                    auto pager = view(ri)->getDatabasePager();
                    if (pager) {
                        auto ico = pager->getIncrementalCompileOperation();
                        if (ico) {
                            ico_jobs[f] = ico->getToCompile().size();
                            snprintf(buf, sizeof(buf), "%d", ico_jobs[f]);
                            ImGuiLTable::PlotShaded("ICO", get_counts, &ico_jobs, frame_count, frame_num, buf, 0u, 4u);
                        }
                    }

                    static unsigned zeroJobFrames = 0;
                    static unsigned zeroJobFramesThreshold = 3;
                    static std::chrono::steady_clock::time_point lastZeroJobTime = now;
                    static long long surgeDuration_ms = 0;

                    if (zeroJobFrames < zeroJobFramesThreshold)
                        surgeDuration_ms = std::chrono::duration_cast<std::chrono::milliseconds>(now - lastZeroJobTime).count();
                    else
                        lastZeroJobTime = now;

                    if (total_jobs[f] == 0)
                        ++zeroJobFrames;
                    else
                        zeroJobFrames = 0;

                    ImGuiLTable::Text("Surge:", "%d ms", surgeDuration_ms);

                    ImGuiLTable::Text("Canceled:", "%s", std::to_string(jobs::get_metrics()->total_canceled()).c_str());
                    ImGuiLTable::End();
                }

                ImGui::Separator();

                auto flags = ImGuiTableFlags_SizingFixedFit | ImGuiTableFlags_RowBg;
                if (ImGui::BeginTable("thread pools", 6, flags))
                {
                    auto metrics = jobs::get_metrics();

                    auto all_pool_metrics = metrics->all();

                    ImGui::TableNextColumn(); ImGui::Text("Pool");
                    ImGui::TableNextColumn(); ImGui::Text("Run"); //ImGui::SetItemTooltip("Running");
                    ImGui::TableNextColumn(); ImGui::Text("Mrg"); //ImGui::SetItemTooltip("Merging / postprocessing");
                    ImGui::TableNextColumn(); ImGui::Text("Que"); //ImGui::SetItemTooltip("Queued jobs (waiting to run)");
                    ImGui::TableNextColumn(); ImGui::Text("Max"); //ImGui::SetItemTooltip("Number of available threads");
                    ImGui::TableNextColumn();

                    for (auto pool_metrics : all_pool_metrics)
                    {
                        if (pool_metrics && pool_metrics->total > 0)
                        {
                            ImGui::TableNextColumn();
                            ImGui::Text("%s", (pool_metrics->name.empty() ? "default" : pool_metrics->name.c_str()));

                            ImGui::TableNextColumn(); ImGui::Text("%d", (int)pool_metrics->running);
                            ImGui::TableNextColumn(); ImGui::Text("%d", (int)pool_metrics->postprocessing);
                            ImGui::TableNextColumn(); ImGui::Text("%d", (int)pool_metrics->pending);
                            //ImGui::TableNextColumn(); ImGui::Text("%d", (int)pool_metrics->canceled);
                            ImGui::TableNextColumn(); ImGui::Text("%d", (int)pool_metrics->concurrency);

                            ImGui::TableNextColumn();
                            ImGui::PushID((std::uintptr_t)pool_metrics);
                            int pc = pool_metrics->concurrency;
                            if (ImGui::InputInt("", &pc))
                                jobs::get_pool(pool_metrics->name)->set_concurrency(
                                    std::max(1, std::min(pc, (int)std::thread::hardware_concurrency())));
                            ImGui::SameLine();
                            ImGui::Checkbox("##visible", &pool_metrics->visible);
                            ImGui::PopID();
                        }
                    }
                    ImGui::EndTable();
                }

                ImGui::Separator();

                if (ImGuiLTable::Begin("caps"))
                {
                    auto& caps = osgEarth::Registry::capabilities();
                    ImGuiLTable::Text("osgEarth", "%s", osgEarthGetVersion());
                    ImGuiLTable::Text("OSG", "%s", osgGetVersion());
                    ImGuiLTable::Text("GL_RENDERER", "%s", caps.getRenderer().c_str());
                    ImGuiLTable::Text("GL_VERSION", "%s", caps.getVersion().c_str());
                    ImGuiLTable::Text("GL Profile", "%s", caps.isCoreProfile() ? "Core" : "Compatibility");
                    ImGuiLTable::End();
                }

#ifdef _WIN32
                ImGui::Separator();
                static float manualDPR = 1.0f;
                if (ImGui::Checkbox("Automatic DPR", &_autoDPR))
                {
                    applyAutoDPR();
                    dirtySettings();
                }

                if (_autoDPR)
                {
                    ImGui::SameLine();
                    ImGui::Text("(%.1f)", _dpr);
                }
                else
                {
                    if (ImGui::SliderFloat("Manual DPR", &manualDPR, 0.5f, 2.0f))
                    {
                        Registry::instance()->setDevicePixelRatioFunction(
                            [&](osg::GraphicsContext*) { return manualDPR; });
                    }
                }
#endif

                ImGui::Separator();

                if (ImGuiLTable::Begin("FontScale"))
                {
                    if (ImGuiLTable::SliderFloat("Font Scale", &_fontScale, 0.5f, 2.5f, "%.2f", 0))
                        dirtySettings();

                    ImGuiLTable::End();
                }

#ifdef _WIN32
                //ImGui::Separator();
                //drawICO(ri);

                ImGui::Separator();
                static bool s_showPagingManagerStats = false;
                ImGui::Checkbox("Paging Manager Stats", &s_showPagingManagerStats);
                if (s_showPagingManagerStats)
                {
                    ImGui::SetNextWindowSize(ImVec2(800, 600), ImGuiCond_FirstUseEver);
                    ImGui::Begin("PagingManager Stats");
                    auto pagingManager = findTopMostNodeOfType<PagingManager>(view(ri)->getSceneData());
                    if (pagingManager)
                    {
                        auto stats = pagingManager->dumpStats();
                        ImGui::Text("Total tracked nodes: %d", (int)stats.size());

                        if (ImGui::BeginTable("pmstats", 3, ImGuiTableFlags_Resizable | ImGuiTableFlags_NoSavedSettings | ImGuiTableFlags_Borders))
                        {
                            ImGui::TableSetupScrollFreeze(0, 1); // Make top row always visible
                            ImGui::TableSetupColumn("Name", ImGuiTableColumnFlags_None);
                            ImGui::TableSetupColumn("MaxRange", ImGuiTableColumnFlags_None);
                            ImGui::TableSetupColumn("LastRange", ImGuiTableColumnFlags_None);
                            ImGui::TableHeadersRow();

                            for (auto& stat : stats)
                            {
                                ImGui::TableNextColumn();
                                ImGui::TextUnformatted(stat.name.c_str());
                                ImGui::TableNextColumn();
                                ImGui::Text("%.1f", stat.maxRange);
                                ImGui::TableNextColumn();
                                ImGui::Text("%.1f", stat.lastRange);
                            }
                            ImGui::EndTable();
                        }
                    }
                    ImGui::End();
                }
#endif
            }
            ImGui::End();
            _first = false;
        }
    };
