        static GLenum inferDataType(GLenum internalFormat, GLenum sourceFormat)
        {
            switch (internalFormat)
            {
            case GL_R16F:
            case GL_RG16F:
            case GL_R32F:
            case GL_RG32F:
#ifdef GL_RGB16F
            case GL_RGB16F:
#endif
#ifdef GL_RGBA16F
            case GL_RGBA16F:
#endif
#ifdef GL_RGB32F
            case GL_RGB32F:
#endif
#ifdef GL_RGBA32F
            case GL_RGBA32F:
#endif
                return GL_FLOAT;

            case GL_R16:
            case GL_RG16:
            case GL_RGB16:
            case GL_RGBA16:
                return GL_UNSIGNED_SHORT;

            default:
                break;
            }

            switch (sourceFormat)
            {
            case GL_ALPHA:
            case GL_LUMINANCE:
            case GL_LUMINANCE_ALPHA:
            case GL_RED:
            case GL_RG:
            case GL_RGB:
            case GL_RGBA:
            case GL_BGR:
            case GL_BGRA:
                return GL_UNSIGNED_BYTE;
            default:
                return 0;
            }
        }

        static std::string enumName(GLenum value, const char* (*nameFunction)(GLenum))
        {
            if (value == 0)
                return "Unknown";

            const char* name = nameFunction(value);
            if (name)
                return name;

            char buffer[16];
            std::snprintf(buffer, sizeof(buffer), "0x%04X", static_cast<unsigned int>(value));
            return buffer;
        }

        static std::string formatBytes(unsigned int bytes)
        {
            char buffer[32];
            if (bytes >= 1024u * 1024u)
                std::snprintf(buffer, sizeof(buffer), "%.2f MB", static_cast<double>(bytes) / (1024.0 * 1024.0));
            else if (bytes >= 1024u)
                std::snprintf(buffer, sizeof(buffer), "%.2f KB", static_cast<double>(bytes) / 1024.0);
            else
                std::snprintf(buffer, sizeof(buffer), "%u B", bytes);
            return buffer;
        }

        static std::string fileName(const std::string& path)
        {
            const std::string::size_type separator = path.find_last_of("/\\");
            return separator == std::string::npos ? path : path.substr(separator + 1u);
        }

        static std::string fileFormat(const std::string& path)
        {
            const std::string name = fileName(path);
            const std::string::size_type dot = name.find_last_of('.');
            if (dot == std::string::npos || dot + 1u == name.size())
                return "Unknown";

            std::string extension = name.substr(dot + 1u);
            const std::string::size_type query = extension.find_first_of("?#");
            if (query != std::string::npos)
                extension.erase(query);

            for (std::string::iterator i = extension.begin(); i != extension.end(); ++i)
                *i = static_cast<char>(std::toupper(static_cast<unsigned char>(*i)));
            return extension.empty() ? "Unknown" : extension;
        }

        static void property(const char* label, const std::string& value)
        {
            const float propertyStart = ImGui::GetCursorPosX();
            ImGui::TextDisabled("%s", label);
            ImGui::SameLine();
            ImGui::SetCursorPosX(propertyStart + 90.0f);
            ImGui::TextUnformatted(value.c_str());
        }

        static void highlightedProperty(const char* label, const std::string& value, const ImVec4& color)
        {
            const float propertyStart = ImGui::GetCursorPosX();
            ImGui::TextDisabled("%s", label);
            ImGui::SameLine();
            ImGui::SetCursorPosX(propertyStart + 90.0f);
            ImGui::PushStyleColor(ImGuiCol_Text, color);
            ImGui::TextUnformatted(value.c_str());
            ImGui::PopStyleColor();
        }

        class FindTexturesVisitor : public osg::NodeVisitor
        {
        public:
            FindTexturesVisitor() :
                osg::NodeVisitor(TRAVERSE_ALL_CHILDREN)
            {
            }

            void apply(osg::Node& node)
            {
                auto stateset = node.getStateSet();
                if (stateset)
                {
                    for (unsigned int i = 0; i < stateset->getTextureAttributeList().size(); ++i)
                    {
                        osg::Texture2D* texture = dynamic_cast<osg::Texture2D*>(stateset->getTextureAttribute(i, osg::StateAttribute::TEXTURE));
                        if (texture)
                        {
                            _textures.insert(texture);
                        }
                    }
                }
                traverse(node);
            }

            typedef std::set< osg::ref_ptr< osg::Texture2D > > TextureSet;
            TextureSet _textures;
        };

    public:
        void draw(osg::RenderInfo& ri) override
        {
            if (!isVisible())
                return;

            if (ImGui::Begin(name(), visible()))
            {
                if (_root.valid() == false)
                    _root = ri.getCurrentCamera();

                if (ImGui::Button("Refresh"))
                {
                    _textures.clear();
                    FindTexturesVisitor findTextures;
                    ri.getCurrentCamera()->accept(findTextures);
                    std::copy(findTextures._textures.begin(), findTextures._textures.end(), std::back_inserter(_textures));
                }
                ImGui::Text("Found %d textures", (int)_textures.size());
                ImGuiStyle& style = ImGui::GetStyle();
                float window_visible_x2 = ImGui::GetWindowPos().x + ImGui::GetWindowContentRegionMax().x;
                unsigned int textureWidth = 100;
                for (unsigned int i = 0; i < _textures.size(); ++i)
                {
                    auto t = _textures[i];
                    osg::ref_ptr<osg::Image> image = t->getImage();
                    std::string name = t.get()->getName();
                    if (name.empty())
                    {
                        name = "Texture";
                    }

                    ImGui::PushID(t.get());
                    ImGui::BeginGroup();
                    ImGui::Text("%s", name.c_str());
                    ImGuiEx::OSGTexture(t.get(), ri, textureWidth);

                    const unsigned int contextID = osgEarth::GLUtils::getSharedContextID(*ri.getState());
                    osg::Texture::TextureObject* textureObject = t->getTextureObject(contextID);

                    const int width = t->getTextureWidth() > 0 ? t->getTextureWidth() : (image ? image->s() : 0);
                    const int height = t->getTextureHeight() > 0 ? t->getTextureHeight() : (image ? image->t() : 0);
                    property("Size:", std::to_string(width) + " x " + std::to_string(height));

                    GLenum internalFormat = static_cast<GLenum>(t->getInternalFormat());
                    if (internalFormat == 0 && textureObject)
                        internalFormat = textureObject->_profile._internalFormat;

                    GLenum sourceFormat = image ? image->getPixelFormat() : t->getSourceFormat();
                    if (sourceFormat == 0 && internalFormat != 0)
                        sourceFormat = osg::Image::computePixelFormat(internalFormat);
                    property("Format:", enumName(sourceFormat, formatName));

                    property("Internal:", enumName(internalFormat, formatName));

                    const bool compressed = (image && image->isCompressed()) || osg::Texture::isCompressedInternalFormat(internalFormat);
                    if (compressed)
                    {
                        const GLenum compressionFormat = image && image->isCompressed() ? image->getPixelFormat() : internalFormat;
                        property("Compression:", enumName(compressionFormat, formatName));
                    }
                    else
                    {
                        highlightedProperty("Compression:", "None (uncompressed)", ImVec4(1.0f, 0.65f, 0.20f, 1.0f));
                    }

                    if (compressed)
                    {
                        // Compressed texture uploads consist of encoded blocks and do not
                        // have an OpenGL scalar data type.
                        property("Data type:", "Block-compressed");
                    }
                    else
                    {
                        GLenum dataType = image ? image->getDataType() : t->getSourceType();
                        if (dataType == 0 && internalFormat != 0)
                            dataType = inferDataType(internalFormat, sourceFormat);
                        property("Data type:", enumName(dataType, dataTypeName));
                    }

                    if (image)
                    {
                        property("Mip levels:", std::to_string(image->getNumMipmapLevels()));
                        property("Image memory:", formatBytes(image->getTotalSizeInBytesIncludingMipmaps()));

                        if (!image->getFileName().empty())
                        {
                            property("File format:", fileFormat(image->getFileName()));
                            property("Source:", fileName(image->getFileName()));
                        }
                    }

                    if (textureObject && textureObject->isAllocated())
                        property("GPU memory:", formatBytes(textureObject->size()));

                    ImGui::EndGroup();

                    float last_button_x2 = ImGui::GetItemRectMax().x;
                    float next_button_x2 = last_button_x2 + style.ItemSpacing.x + textureWidth; // Minimum expected position if next texture was on the same line
                    if (i + 1 < _textures.size() && next_button_x2 < window_visible_x2)
                        ImGui::SameLine();

                    ImGui::PopID();
                }
                ImGui::End();
            }
        }

        std::vector< osg::ref_ptr< osg::Texture2D > > _textures;
