#pragma once
#include <osgEarthPrestige/Export>
#include <osgEarth/Style>
#include <osg/Node>
#include <osg/Vec3d>
#include <memory>

namespace osgEarthPrestige
{
    class LabelLayer;

    /** Screen-facing text attached to a scene-graph position, rendered by its explicitly assigned LabelLayer.
     * Add the layer to the map, and attach this node anywhere under the same world root (including GeoTransform).
     * Position is local to the parent; parent rotation/scale move the anchor, not the screen-sized text.
     * Use one parental path per node; clone a node to instance it at another position.
     * Primary-camera traversal/masks/LOD and anchor projection determine visibility; fixed-radius culling is disabled.
     * Membership is sampled from the previous completed frame before fading.
     * Text, priority and constant text styling share the layer's tiled-label solver; higher priority wins.
     * The layer supplies the font. Terrain clamping belongs to the parent GeoTransform; icons/picking are not provided.
     * Setters, copying, and destruction require exclusive scene access (as with other OSG scene mutations).
     * Empty text hides the label. Each layer admits at most 1024 live LabelNodes; excess registration throws.
     */
    class OSGEARTHPRESTIGE_EXPORT LabelNode : public osg::Node
    {
    public:
        //! Creates an unbound, empty node; setLayer before rendering. No GL or font work occurs here.
        LabelNode();
        //! Binds a node to a layer's shared renderer; invalid text/style or exhausted capacity throws.
        LabelNode(LabelLayer* layer, const std::string& text, const osgEarth::Style& style = osgEarth::Style());
        //! Copies appearance and layer binding with a fresh identity and independent lifetime.
        LabelNode(const LabelNode& rhs, const osg::CopyOp& copy = osg::CopyOp::SHALLOW_COPY);
        META_Node(osgEarthPrestige, LabelNode);

        //! Rebinds to a layer without owning it; null detaches. Exhausted capacity leaves the old binding intact.
        void setLayer(LabelLayer* layer);
        //! Returns the assigned layer, or null after it is destroyed; call with exclusive scene access.
        LabelLayer* getLayer() const;
        //! Sets literal UTF-8 text (not an expression); empty hides, over 4096 bytes throws.
        void setText(const std::string& text);
        //! Returns the literal text; reference remains valid until a setter or destruction.
        const std::string& getText() const;
        //! Sets constant TextSymbol styling using the same parser as LabelLayer; invalid values throw.
        void setStyle(const osgEarth::Style& style);
        //! Sets CSS or structured styling, preserving text-halo-width and text-halo-softness extensions.
        void setStyle(const osgEarth::Config& style);
        //! Returns retained styling, including Prestige extensions.
        const osgEarth::Config& getStyleConfig() const;
        //! Sets the local anchor; nonfinite coordinates throw and parent bounds are dirtied.
        void setPosition(const osg::Vec3d& position);
        //! Returns the local anchor (use a GeoTransform parent for geographic coordinates).
        const osg::Vec3d& getPosition() const;
        //! Sets collision priority; larger values win against both node and tiled labels. Nonfinite values throw.
        void setPriority(float priority);
        //! Returns the collision priority, initially zero.
        float getPriority() const;
        //! Records primary-camera visibility/anchor only; shaping, layout and geometry preparation run on workers.
        void traverse(osg::NodeVisitor& visitor) override;
        //! Returns a local anchor bound for distance/LOD queries; screen-sized visibility uses anchor projection.
        osg::BoundingSphere computeBound() const override;

    protected:
        //! Unregisters content; in-flight camera results retain immutable data until their fades/draws retire.
        ~LabelNode() override;
    private:
        struct Impl;
        std::unique_ptr<Impl> _impl;
    };
}
