    class PlacementFeatureProvider;

    //! Named input; its namespace distinguishes feature IDs from other providers.
    struct OSGEARTHPROCEDURAL2_EXPORT FeatureInput
    {
        std::string name;
        LayerReference<FeatureSource> features;
        std::shared_ptr<const PlacementFeatureProvider> provider; // alternative application/composition input
        //! Creates an unconfigured input for programmatic setup.
        FeatureInput() = default;
        //! Reads a name and either an osgEarth feature-layer reference or an editable provider definition.
        explicit FeatureInput(const Config&);
        //! Serializes the input without reading its data.
        Config getConfig() const;
    };

    //! Resolved lattice in one stable metric frame, independent of clipped source/page boundaries.
    struct RowPattern
    {
        unsigned zone = 0; // zero for an explicit anchor; otherwise fixed world strip 1..60
        osg::ref_ptr<const SpatialReference> frame;
        GeoExtent extent; // matching polygon bounds, in frame
        GeoExtent domain; // half-open geographic ownership for a world strip; unset for an explicit anchor
        double heading = 0.0, rowSpacing = 4.0, plantSpacing = 2.0;
    };

    //! Configuration for straight rows/grids. Source attributes override explicit rule defaults.
    struct OSGEARTHPROCEDURAL2_EXPORT RowLayout
    {
        std::string originMode = "explicit"; // explicit anchor or fixed world projection strips
        double longitude = std::numeric_limits<double>::quiet_NaN();
        double latitude = std::numeric_limits<double>::quiet_NaN();
        double heading = 0.0; // clockwise degrees from local north; zero is the deterministic default
        double rowSpacing = 4.0, plantSpacing = 2.0; // meters
        std::string longitudeAttribute, latitudeAttribute, headingAttribute, rowSpacingAttribute, plantSpacingAttribute;
        //! Creates default spacing with an unspecified anchor; source attributes may supply it.
        RowLayout() = default;
        //! Reads optional geographic anchor, spacing, direction, and attribute bindings.
        explicit RowLayout(const Config&);
        //! Serializes settings without writing nonfinite unset anchor values.
        Config getConfig() const;
        //! Validates explicit anchors or world mode; never derives phase from a clipped polygon centroid.
        Status validate() const;
        //! Resolves a metric frame and source overrides. World mode needs zone 1..60; explicit anchors have a 100km limit.
        Status resolve(const Feature&, const ScatterGroup&, RowPattern&, unsigned worldZone = 0) const;
    };

    //! Attribute rule independent of source format, placement strategy, and asset selection.
    struct OSGEARTHPROCEDURAL2_EXPORT CoverageRule
    {
        std::string source = "*", group = "*", key, value = "*", exceptValue;
        std::string action = "include"; // include polygon, exclude polygon/line, or explicit points
        std::string strategy = "scatter", name; // named region rules select a registered strategy
        int priority = 0; // higher inclusion wins; equal priority prefers a region strategy; exclusions always win
        Config parameters; // strategy-owned <placement> settings; source adapters do not interpret these
        double buffer = 0.0; // line exclusion half-width in meters
        float density = 1.0f; // fractional acceptance, separate from hard exclusion
        //! Creates an unconfigured rule.
        CoverageRule() = default;
        //! Reads an exact attribute match or '*' for any present value.
        explicit CoverageRule(const Config&);
        //! Serializes rule policy.
        Config getConfig() const;
        //! Rejects unsupported actions, missing keys, and unbounded parameters.
        Status validate() const;
        //! Tests source, population, and attributes without changing the feature.
        bool matches(const std::string& input, const ScatterGroup&, const Feature&) const;
    };

    //! Immutable feature owned by a query result, with its stable provider namespace.
    struct PlacementFeature
    {
        std::string source;
        osg::ref_ptr<const Feature> feature;
        // Optional native-tile metric frame shared by buffered features; independent of vegetation batching.
        osg::ref_ptr<const SpatialReference> metric;
    };

    //! Worker-owned fragments of one named strategy region, with stable identity and unchanged source attributes.
    struct PlacementRegion
    {
        std::uint64_t id = 0;
        std::string strategy;
        Config parameters;
        GeoExtent extent; // union of polygon bounds in the request SRS
        std::vector<osg::ref_ptr<const Feature>> fragments;
    };

    //! Query-local selection supplied by the coverage compiler; adapters remain independent of OSM tag policy.
    using PlacementFeatureFilter = std::function<bool(const std::string&, const Feature&)>;

    //! Data adapter contract. Implementations must support concurrent bounded, cancelable worker queries.
    class OSGEARTHPROCEDURAL2_EXPORT PlacementFeatureProvider
    {
    public:
        //! Releases an adapter through its interface.
        virtual ~PlacementFeatureProvider() = default;
        //! Checks provider configuration without querying data; immutable adapters need no extra validation.
        virtual Status validate() const { return Status::NoError; }
        //! Serializes an optional provider definition; external application providers may return empty config.
        virtual Config getConfig() const { return Config(); }
        //! Monotonic revision or a revision signature; zero denotes an immutable provider.
        virtual std::uint64_t revision() const { return 0; }
        //! Freezes mutable inputs for a worker request; null means this provider is already immutable.
        virtual std::shared_ptr<const PlacementFeatureProvider> snapshot() const { return {}; }
        //! Reports changed geographic regions against an earlier snapshot. Unknown changes invalidate the world.
        virtual void changesSince(const PlacementFeatureProvider*, std::vector<GeoExtent>& output) const
        { output.emplace_back(SpatialReference::get("wgs84"), -180.0, -90.0, 180.0, 90.0); }
        //! Replaces output on success; failure/cancellation leaves it empty. Buffer is in meters.
        virtual Status query(const TileKey&, double buffer, std::vector<PlacementFeature>&,
            ProgressCallback* = nullptr) const = 0;
        //! Selects relevant features; adapters may override to avoid copying unrelated records. Default uses query().
        virtual Status queryFiltered(const TileKey&, double, const PlacementFeatureFilter&,
            std::vector<PlacementFeature>&, ProgressCallback* = nullptr) const;
    };

    //! Bridges existing open FeatureSources, including tiled OSM, to vegetation's independent grid.
    class OSGEARTHPROCEDURAL2_EXPORT MapFeatureProvider : public PlacementFeatureProvider
    {
    public:
        //! Retains resolved inputs; they must stay open and worker-queryable while the provider is in use.
        explicit MapFeatureProvider(const std::vector<FeatureInput>&, bool frozen = false);
        //! Combines source revisions without reading features; frozen snapshots retain their captured signature.
        std::uint64_t revision() const override;
        //! Captures all editable providers once so a worker batch sees one composition revision.
        std::shared_ptr<const PlacementFeatureProvider> snapshot() const override;
        //! Collects changed regions from mutable inputs; ordinary dirty FeatureSources invalidate their extent.
        void changesSince(const PlacementFeatureProvider*, std::vector<GeoExtent>&) const override;
        //! Queries native source tiles with a halo, bounded to 64 tiles/input and 100,000 features/request.
        Status query(const TileKey&, double, std::vector<PlacementFeature>&, ProgressCallback*) const override;
        //! Applies selection and the buffered page extent before copying; bounds scanned and retained records.
        Status queryFiltered(const TileKey&, double, const PlacementFeatureFilter&,
            std::vector<PlacementFeature>&, ProgressCallback*) const override;
    private:
        std::vector<FeatureInput> _inputs;
        std::vector<std::uint64_t> _revisions;
        bool _frozen = false;
    };

    //! Fractional density supports future feathering; an exclusion always wins over density.
    struct CoverageSample
    {
        float density = 0.0f;
        bool excluded = false;
        std::uint64_t pattern = 0; // zero selects natural scatter; otherwise the winning structured pattern
    };

    //! Worker-local field in the request SRS. Strategies need not know its vector/raster implementation.
    class OSGEARTHPROCEDURAL2_EXPORT PlacementField
    {
    public:
        //! Releases a query field through its interface.
        virtual ~PlacementField() = default;
        //! Samples generated placement coverage at a finite point in the request SRS.
        virtual CoverageSample sample(const osg::Vec3d&) const = 0;
        //! Samples an explicit source root. Vector fields bypass line buffers but retain polygon exclusions.
        //! Custom fields inherit ordinary sampling unless they distinguish buffered exclusions themselves.
        virtual CoverageSample sampleExplicit(const osg::Vec3d& point) const { return sample(point); }
        //! True only when the entire rectangle has one coverage value. False requests subdivision;
        //! the conservative default never certifies untested coverage or misses a narrow exclusion.
        virtual bool uniform(const GeoExtent&, CoverageSample&) const { return false; }
        //! Conservative fast path: false means no scattered candidates can survive; explicit points are separate.
        virtual bool hasDensity() const { return true; }
        //! Explicit source points, owned by this request with stable provider-derived IDs.
        virtual const std::vector<ScatterPlacement>& points() const = 0;
        //! Structured regions; the default preserves compatibility with fields supplying scatter/points only.
        virtual const std::vector<PlacementRegion>& regions() const
        { static const std::vector<PlacementRegion> empty; return empty; }
    };

    //! Replaceable algorithm separate from geographic adapters, coverage rules, and rendering.
    class OSGEARTHPROCEDURAL2_EXPORT PlacementStrategy
    {
    public:
        //! Releases a strategy through its interface.
        virtual ~PlacementStrategy() = default;
        //! Replaces output atomically; coordinates use key's SRS and IDs must survive reloads/batching.
        virtual Status generate(const TileKey&, const ScatterGroup&, unsigned seed, const PlacementField&,
            std::vector<ScatterPlacement>&, ProgressCallback*) const = 0;
    };

    //! Filters stable natural scatter and preserves explicit points; does not move rejected candidates.
    class OSGEARTHPROCEDURAL2_EXPORT NaturalPlacementStrategy : public PlacementStrategy
    {
    public:
        //! Uses a density hash independent of coordinates, asset choice, and distance thinning.
        Status generate(const TileKey&, const ScatterGroup&, unsigned, const PlacementField&,
            std::vector<ScatterPlacement>&, ProgressCallback*) const override;
    };

    //! Application extension point for region-specific layouts: rows, orchards, lawns, playgrounds, and others.
    //! Instances are shared by paging workers; implementations must be immutable or internally synchronized.
    class OSGEARTHPROCEDURAL2_EXPORT RegionPlacementStrategy
    {
    public:
        //! Releases a registered algorithm through the shared interface.
        virtual ~RegionPlacementStrategy() = default;
        //! Checks strategy-owned rule settings before opening the layer; no I/O or GL calls.
        virtual Status validate(const Config&) const { return Status::NoError; }
        //! Emits bounded candidates in key's SRS. The dispatcher enforces cell ownership, winning region,
        //! hard exclusions, fractional coverage, cancellation, and limits before publishing any placement.
        //! Stable IDs must derive from region identity and layout slots, never from clipped fragment bounds.
        virtual Status generate(const TileKey&, const ScatterGroup&, unsigned seed, const PlacementRegion&,
            std::vector<ScatterPlacement>&, ProgressCallback*) const = 0;
    };

    using PlacementStrategies = std::map<std::string, std::shared_ptr<const RegionPlacementStrategy>>;

    //! Enumerates an anchored integer lattice; asset selection, coverage, and terrain attachment remain separate.
    class OSGEARTHPROCEDURAL2_EXPORT RowPlacementStrategy : public RegionPlacementStrategy
    {
    public:
        //! Validates row settings and anchor bindings before paging starts.
        Status validate(const Config&) const override;
        //! Generates a bounded lattice in the requested cell; rejects inconsistent fragment metadata.
        Status generate(const TileKey&, const ScatterGroup&, unsigned, const PlacementRegion&,
            std::vector<ScatterPlacement>&, ProgressCallback*) const override;
    };

    //! Returns the built-in region algorithms; applications may extend a copy before attaching a layer.
    OSGEARTHPROCEDURAL2_EXPORT PlacementStrategies defaultPlacementStrategies();

    //! Dispatches natural scatter, explicit points, and registered region strategies through shared exclusions.
    class OSGEARTHPROCEDURAL2_EXPORT MixedPlacementStrategy : public PlacementStrategy
    {
    public:
        //! Copies an immutable registry snapshot; defaults include the row/grid algorithm.
        explicit MixedPlacementStrategy(const PlacementStrategies& strategies = defaultPlacementStrategies());
        //! Combines strategies atomically. Unknown names fail explicitly instead of silently scattering.
        Status generate(const TileKey&, const ScatterGroup&, unsigned, const PlacementField&,
            std::vector<ScatterPlacement>&, ProgressCallback*) const override;
    private:
        PlacementStrategies _strategies;
    };

    //! Composes a feature adapter, coverage rules, and placement algorithm for the existing pager.
    class OSGEARTHPROCEDURAL2_EXPORT FeatureScatterSource : public ScatterSource
    {
    public:
        //! Copies immutable policy; null strategy selects MixedPlacementStrategy.
        FeatureScatterSource(std::shared_ptr<const PlacementFeatureProvider>, const std::vector<CoverageRule>&,
            std::shared_ptr<const PlacementStrategy> = {});
        //! Current geographic-source revision, independent of rendering and paging.
        std::uint64_t revision() const override { return _provider ? _provider->revision() : 0; }
        //! Captures one composition snapshot while retaining placement rules and strategy.
        std::shared_ptr<const ScatterSource> snapshot() const override;
        //! Reports raw source-change regions; consumers account for their own rule/representation buffers.
        void changesSince(const ScatterSource*, std::vector<GeoExtent>&) const override;
        //! Geographic fields are available without enumerating individual plants.
        bool supportsCoverage() const override { return true; }
        //! Compiles the same rules used by detailed placement, including holes and buffered roads.
        Status queryField(const TileKey&, const ScatterGroup&, unsigned, std::shared_ptr<const PlacementField>&,
            ProgressCallback* = nullptr) const override;
        //! Adds a footprint halo to the rule buffers, retaining exclusions beyond the page's ownership boundary.
        Status queryFieldBuffered(const TileKey&, const ScatterGroup&, unsigned, double,
            std::shared_ptr<const PlacementField>&, ProgressCallback* = nullptr) const override;
        //! Queries one source cell; errors never publish partial placement.
        Status generate(const TileKey&, const ScatterGroup&, unsigned, std::vector<ScatterPlacement>&,
            ProgressCallback* = nullptr) const override;
        //! Queries geographic data once for the whole batch while retaining original source-cell identity.
        Status generateBatch(const TileKey&, const ScatterGroup&, unsigned, std::vector<ScatterPlacement>&,
            ProgressCallback* = nullptr) const override;
    private:
        //! Shared implementation; batch controls bounded enumeration of the original source cells.
        Status generateImpl(const TileKey&, const ScatterGroup&, unsigned, bool batch,
            std::vector<ScatterPlacement>&, ProgressCallback*) const;
        std::shared_ptr<const PlacementFeatureProvider> _provider;
        std::shared_ptr<const PlacementStrategy> _strategy;
        std::vector<CoverageRule> _rules;
    };
} }
