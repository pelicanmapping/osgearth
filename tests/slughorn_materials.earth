<!-- Run osgearth_imgui slughorn_materials.earth --nvgl --prestige-sky.
     Slug GPU vector imagery. Build with OSGEARTH_ENABLE_SLUGHORN=ON.
     OSM is available only at LOD 14; zoom past that level to exercise atlas inheritance.
     max_data_level caps loading while leaving higher terrain LODs visible.
     Requires network access and an osgEarth build with MVT/Protobuf support. -->
<map name="Slughorn - Single-layer PBR materials">
    <XYZFeatures name="osm">
        <url>https://readymap.org/readymap/mbtiles/osm/{z}/{x}/{-y}.pbf</url>
        <min_level>14</min_level>
        <max_level>14</max_level>
        <profile>spherical-mercator</profile>
        <format>pbf</format>
        <fid_attribute>@id</fid_attribute>
    </XYZFeatures>
    <TMSImage name="ReadyMap Imagery">
        <url>https://readymap.org/readymap/tiles/1.0.0/7</url>
    </TMSImage>
    <!-- All six select symbols share one FeatureImageLayer and one atlas per source tile.
         Styles paint in stylesheet order: land use, water, buildings, then roads. -->
    <FeatureImage name="OSM selected features" mode="vector" min_level="14" max_data_level="14" buffer_width="20m">
        <features>osm</features>
        <material_anchor>-157.832765,21.296265,0</material_anchor>
        <materials>
            <material name="asphalt" color="../data/asphalt.jpg" roughness_factor="0.9" metallic_factor="0" />
            <material name="stone" color="../data/prestige/vegetation/pbr/stone-albedo.png"
                normal="../data/prestige/vegetation/pbr/stone-normal.png"
                packed="../data/prestige/vegetation/pbr/stone-dram.png" layout="dram" />
        </materials>
        <!-- <background_color>#eee9df</background_color> -->
        <attribution>OpenStreetMap contributors (ODbL)</attribution>
        <styles>
            <style type="text/css">
                <![CDATA[
            water {
                select: feature.properties.natural === 'water' || feature.properties.waterway === 'riverbank';
                fill: #87bdd8;
            }
            streams {
                select: feature.properties.waterway === 'stream' || feature.properties.waterway === 'river';
                stroke: #87bdd8;
                stroke-width: 5m;
                stroke-linecap: round;
            }

            buildings {
                select: 'building' in feature.properties;
                fill: #bb9a85;
                fill-opacity: 0.85;
                stroke: #846b5d;
                stroke-opacity: 0.85;
                stroke-width: 0.6m;
            }

            minor {
                stroke-material: asphalt;
                stroke-material-period: 2m;
                stroke-outline-material: stone;
                select: ['residential', 'unclassified', 'service', 'tertiary'].indexOf(feature.properties.highway) >= 0;
                stroke: #ffffff;
                stroke-width: 5m;
                stroke-linecap: round;
                stroke-linejoin: round;
                stroke-outline: #ffffff;
                stroke-outline-width: 0.5m;
            }
            major {
                stroke-material: stone;
                stroke-material-period: 1m;
                select: ['motorway', 'trunk', 'primary', 'secondary'].indexOf(feature.properties.highway) >= 0;
                stroke: #ffffff;
                stroke-width: 10m;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
        ]]>
            </style>
        </styles>
    </FeatureImage>
    <options>
        <terrain color="#87bdd8"/>
    </options>
    <viewpoints home="0" time="0">
        <viewpoint name="Honolulu">
            <heading>-0.206162</heading>
            <pitch>-89.9</pitch>
            <range>7764.05m</range>
            <long>-157.8327649343271</long>
            <lat>21.29626496396804</lat>
            <height>-0.02048836834728718</height>
            <srs>+proj=longlat +datum=WGS84 +no_defs</srs>
        </viewpoint>
        <viewpoint name="Annandale">
            <heading>2.48738e-07</heading>
            <pitch>-88.9987</pitch>
            <range>7146.65m</range>
            <long>-77.19481952051895</long>
            <lat>38.83325130835141</lat>
            <height>-0.4578634602949023</height>
            <srs>+proj=longlat +datum=WGS84 +no_defs</srs>
        </viewpoint>
    </viewpoints>
</map>