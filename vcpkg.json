{
  "name": "osgearth",
  "version-string": "3.8.1",
  "port-version": 1,
  "description": "osgEarth - 3D Maps and Terrain - Copyright 2026 Pelican Mapping",
  "homepage": "https://github.com/gwaldron/osgearth",
  "supports": "!(x86 | wasm32)",
  "dependencies": [
    "benchmark",
    "blend2d",
    "draco",
    "lerc",
    {
      "name": "gdal",
      "default-features": false,
      "features": [
        "recommended-features",
        "jpeg",
        "tools"
      ]
    },
    "geos",
    "libwebp",
    "libzip",
    "opengl",
    {
      "name": "osg",
      "features": [
        "tools"
      ]
    },
    "protobuf",
    "sqlite3",
    "spdlog",
    "meshoptimizer",
    {
      "name": "aws-sdk-cpp",
      "features": [
        "s3"
      ]
    }
  ]
}
